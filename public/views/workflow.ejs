      // Fix input ports (left side)
      const leftPorts = node.querySelectorAll('.node-connection-point');
      leftPorts.forEach(port => {
        const hasLeft = port.style.left && port.style.left !== '';
        const hasRight = port.style.right && port.style.right !== '';
        
