<!-- Agent Widget with Memory -->
<div id="agent-widget-container" class="fixed bottom-5 right-5 z-50">
  <!-- FAB Button -->
  <button id="agent-fab" class="btn btn-primary btn-circle btn-lg shadow-lg" onclick="toggleAgentChat()">
    <i id="agent-icon" class="ti ti-message-chatbot text-3xl"></i>
  </button>

  <!-- Chat Popup -->
  <div id="agent-chat-popup" class="hidden fixed bg-base-100 rounded-lg shadow-2xl border border-base-300 flex flex-col" style="width: 24rem; height: 32rem; bottom: 5.5rem; right: 1.25rem;">
    <!-- Header -->
    <div id="chat-header" class="card-title bg-base-200 p-4 flex items-center justify-between cursor-move">
      <h2 class="text-lg font-bold flex items-center">
        <i class="ti ti-message-chatbot mr-2"></i> Bioinfo Agent
        <span id="session-indicator" class="badge badge-success badge-sm ml-2 hidden">Memory</span>
        <span id="model-indicator" class="badge badge-primary badge-sm ml-2">qwen-plus</span>
      </h2>
      <div class="flex items-center gap-1">
        <button id="model-settings-btn" class="btn btn-sm btn-ghost btn-circle" title="Model Settings">
          <i class="ti ti-settings"></i>
      </button>
        <button id="session-menu-btn" class="btn btn-sm btn-ghost btn-circle" title="Session Management">
            <i class="ti ti-history"></i>
        </button>
        <button id="clear-chat-btn" class="btn btn-sm btn-ghost btn-circle" title="Clear chat history">
            <i class="ti ti-trash"></i>
        </button>
        <button class="btn btn-sm btn-ghost btn-circle" onclick="toggleAgentChat()">
            <i class="ti ti-x"></i>
        </button>
      </div>
    </div>

    <!-- Session Sidebar (side drawer) -->
    <div id="session-sidebar" class="fixed left-0 top-0 h-full w-80 bg-base-100 shadow-2xl border-r border-base-300 transform -translate-x-full transition-transform duration-300 ease-in-out z-50 hidden">
      <div class="flex flex-col h-full">
        <!-- Sidebar Header -->
        <div class="flex items-center justify-between p-4 border-b border-base-300">
          <h2 class="font-bold text-lg">Chat History</h2>
          <button id="close-session-sidebar" class="btn btn-sm btn-ghost btn-circle">
            <i class="ti ti-x"></i>
          </button>
        </div>
        
        <!-- New Chat Button -->
        <div class="p-4 border-b border-base-300">
          <button id="new-session-btn" class="btn btn-primary w-full">
            <i class="ti ti-plus mr-2"></i> New Chat
          </button>
        </div>

        <!-- Session List -->
        <div class="flex-1 overflow-y-auto p-4">
          <div id="session-list">
            <div class="text-center py-8 opacity-60">
              <i class="ti ti-message-circle text-4xl mb-2"></i>
              <p class="text-sm">Loading chat history...</p>
            </div>
          </div>
        </div>

        <!-- Sidebar Footer -->
        <div class="p-4 border-t border-base-300">
          <div class="flex gap-2">
            <button id="save-session-btn" class="btn btn-sm btn-success flex-1">
              <i class="ti ti-device-floppy mr-1"></i> Save
            </button>
            <button id="cleanup-sessions-btn" class="btn btn-sm btn-warning flex-1">
              <i class="ti ti-trash mr-1"></i> Cleanup
            </button>
          </div>
          <div class="mt-2 text-xs opacity-60 text-center" id="session-status">
            No active session
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar Overlay -->
    <div id="sidebar-overlay" class="fixed inset-0 bg-black bg-opacity-50 z-40 hidden" onclick="hideSidebar()"></div>

    <!-- Chat Body -->
    <div id="chat-body" class="card-body flex-grow p-4 overflow-y-auto bg-base-100" style="flex: 1 1 auto;">
      <!-- Messages will be appended here -->
      <div class="chat chat-start">
        <div class="chat-bubble chat-bubble-primary">
          <div class="markdown-content">
            <p>Hello! How can I help you with bioinformatics tools today?</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Input Area -->
    <div class="card-footer bg-base-200 p-4 border-t border-base-300">
      <div class="flex items-center space-x-2 mb-2">
        <input type="text" id="chat-input" class="input input-bordered w-full" placeholder="Ask a question..." autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-form-type="other">
        <button id="chat-send-btn" class="btn btn-primary btn-circle">
          <i class="ti ti-send"></i>
        </button>
        <!-- Stop Generation Button (hidden by default) -->
        <button id="stop-generation-btn" class="btn btn-error btn-circle hidden" title="Stop generation">
          <i class="ti ti-square"></i>
        </button>
        <button id="viz-generate-btn" class="btn btn-ghost btn-sm gap-1" title="Generate visualization code from current input">
          <i class="ti ti-wand"></i>
          Generate Code
        </button>
      </div>
      <div class="flex items-center gap-2 text-sm">
        <span class="opacity-70">Selected data file:</span>
        <span id="selected-viz-file" class="truncate flex-1" title=""></span>
        <button id="select-file-btn" class="btn btn-xs btn-outline">Pick File</button>
        <button id="set-file-btn" class="btn btn-xs btn-ghost">Paste Path</button>
        <label class="flex items-center gap-1 text-xs whitespace-nowrap">
          Lib:
          <select id="viz-lib-select" class="select select-xs select-bordered">
            <option value="seaborn">seaborn</option>
            <option value="matplotlib">matplotlib</option>
            <option value="bokeh">bokeh</option>
          </select>
        </label>
      </div>
    </div>
    <!-- Model Settings Modal -->
<div id="model-settings-modal" class="modal">
  <div class="modal-box w-11/12 max-w-md">
    <h3 class="font-bold text-lg mb-4">Model Settings</h3>
    
    <!-- Current Model Display -->
    <div class="alert alert-info mb-4">
      <i class="ti ti-info-circle"></i>
      <div>
        <div class="font-semibold">Current Model</div>
        <div id="current-model-display">qwen-plus</div>
      </div>
    </div>
    
    <!-- Model Selection -->
    <div class="form-control mb-4">
      <label class="label">
        <span class="label-text font-semibold">Select Model</span>
      </label>
      <select id="model-select" class="select select-bordered w-full">
        <option value="qwen-plus">Qwen Plus - Fast & Balanced</option>
        <option value="gemini-2.5-pro">Gemini 2.5 Pro - Advanced Reasoning</option>
        <option value="deepseek-r1:8b">DeepSeek R1 8B - Local (Ollama)</option>
      </select>
      <label class="label">
        <span class="label-text-alt" id="model-description">Fast and balanced performance for general questions</span>
      </label>
    </div>
    
    <!-- API Key Input -->
    <div class="form-control mb-4">
      <label class="label">
        <span class="label-text font-semibold">API Key</span>
        <span class="label-text-alt" id="api-key-status">Not configured</span>
      </label>
      <div class="input-group">
        <input id="api-key-input" type="password" class="input input-bordered flex-1" 
               placeholder="Enter your API key" autocomplete="new-password" data-form-type="other">
        <button id="toggle-api-key" class="btn btn-square btn-outline" type="button">
          <i class="ti ti-eye"></i>
        </button>
      </div>
      <label class="label">
        <span class="label-text-alt">
          Get your key: <a id="api-key-link" href="https://dashscope.console.aliyun.com/" target="_blank" class="link">API Console</a>
        </span>
      </label>
    </div>
    
    <!-- Connection Status -->
    <div id="connection-status" class="alert alert-warning mb-4 hidden">
      <i class="ti ti-alert-triangle"></i>
      <span id="connection-message">Testing connection...</span>
    </div>
    
    <!-- Modal Actions -->
    <div class="modal-action">
      <button id="test-connection-btn" class="btn btn-outline">
        <i class="ti ti-plug"></i>
        Test
      </button>
      <button id="apply-model-btn" class="btn btn-primary">
        <i class="ti ti-check"></i>
        Apply
      </button>
      <button class="btn" onclick="closeModelSettings()">Cancel</button>
    </div>
  </div>
</div>
    <!-- Resize Handles -->
    <div class="resize-handle n"></div><div class="resize-handle s"></div>
    <div class="resize-handle e"></div><div class="resize-handle w"></div>
    <div class="resize-handle nw"></div><div class="resize-handle ne"></div>
    <div class="resize-handle sw"></div><div class="resize-handle se"></div>
  </div>
</div>

<!-- Embedded file picker modal -->
<dialog id="file-picker-modal" class="modal">
  <div class="modal-box w-11/12 max-w-4xl p-0">
    <div class="flex items-center justify-between px-4 py-3 border-b border-base-300">
      <div class="font-semibold">Select Remote Data File</div>
      <button id="close-picker-btn" class="btn btn-sm btn-ghost btn-circle"><i class="ti ti-x"></i></button>
    </div>
    <div class="h-[70vh]">
      <iframe id="file-picker-frame" src="" class="w-full h-full border-0"></iframe>
    </div>
  </div>
</dialog>

<script>
  const agentFab = document.getElementById('agent-fab');
  const agentChatPopup = document.getElementById('agent-chat-popup');
  const agentIcon = document.getElementById('agent-icon');
  const chatHeader = document.getElementById('chat-header');
  const clearChatBtn = document.getElementById('clear-chat-btn');
  const chatBody = document.getElementById('chat-body');
  const chatInput = document.getElementById('chat-input');
  const chatSendBtn = document.getElementById('chat-send-btn');
  const stopGenerationBtn = document.getElementById('stop-generation-btn');
  
  // AbortController for stopping generation
  let currentAbortController = null;
  
  // Memory-related elements
  const sessionMenuBtn = document.getElementById('session-menu-btn');
  const sessionSidebar = document.getElementById('session-sidebar');
  const closeSessionSidebar = document.getElementById('close-session-sidebar');
  const sidebarOverlay = document.getElementById('sidebar-overlay');
  const sessionIndicator = document.getElementById('session-indicator');
  const sessionStatus = document.getElementById('session-status');
  const sessionList = document.getElementById('session-list');
  const newSessionBtn = document.getElementById('new-session-btn');
  const saveSessionBtn = document.getElementById('save-session-btn');
  const cleanupSessionsBtn = document.getElementById('cleanup-sessions-btn');

  // === Model Settings ===
  const modelSettingsBtn = document.getElementById('model-settings-btn');
  const modelSettingsModal = document.getElementById('model-settings-modal');
  const modelSelect = document.getElementById('model-select');
  const apiKeyInput = document.getElementById('api-key-input');
  const toggleApiKeyBtn = document.getElementById('toggle-api-key');
  const testConnectionBtn = document.getElementById('test-connection-btn');
  const applyModelBtn = document.getElementById('apply-model-btn');
  const currentModelDisplay = document.getElementById('current-model-display');
  const modelDescription = document.getElementById('model-description');
  const apiKeyStatus = document.getElementById('api-key-status');
  const apiKeyLink = document.getElementById('api-key-link');
  const connectionStatus = document.getElementById('connection-status');
  const connectionMessage = document.getElementById('connection-message');

  // Model information
  const MODEL_INFO = {
    'qwen-plus': {
      display_name: 'Qwen Plus',
      description: 'Fast and balanced performance for general questions',
      provider: 'qwen',
      apiUrl: 'https://dashscope.console.aliyun.com/',
      keyEnv: 'DASHSCOPE_API_KEY'
    },
    'gemini-2.5-pro': {
      display_name: 'Gemini 2.5 Pro', 
      description: 'Advanced reasoning capabilities for complex analysis',
      provider: 'gemini',
      apiUrl: 'https://aistudio.google.com/apikey',
      keyEnv: 'GEMINI_API_KEY'
    },
    'deepseek-r1:8b': {
      display_name: 'DeepSeek R1 8B',
      description: 'Local model running on Ollama - no API key required',
      provider: 'ollama',
      apiUrl: 'https://ollama.com/',
      keyEnv: null,
      requiresApiKey: false
    }
  };

  let currentModel = 'qwen-plus';

  // Initialize model settings
  async function initializeModelSettings() {
    try {
      const response = await fetch('/api/agent/models');
      if (response.ok) {
        const data = await response.json();
        currentModel = data.current_model.model_name;
        updateModelDisplay();
        loadStoredApiKey();
      }
    } catch (error) {
      console.error('Failed to load model settings:', error);
    }
  }

  // Update model display
  function updateModelDisplay() {
    const modelInfo = MODEL_INFO[currentModel];
    currentModelDisplay.textContent = modelInfo.display_name;
    modelSelect.value = currentModel;
    updateModelDescription();
    updateApiKeyStatus();
    
    // Update model indicator in chat header
    const modelIndicator = document.getElementById('model-indicator');
    if (modelIndicator) {
      modelIndicator.textContent = currentModel;
    }
  }

  // Update model description and API link
  function updateModelDescription() {
    const modelInfo = MODEL_INFO[modelSelect.value];
    modelDescription.textContent = modelInfo.description;
    apiKeyLink.href = modelInfo.apiUrl;
  }

  // Update API key status
  function updateApiKeyStatus() {
    const selectedModel = modelSelect.value;
    const modelInfo = MODEL_INFO[selectedModel];
    
    // Check if this model requires an API key
    if (modelInfo.requiresApiKey === false) {
      apiKeyStatus.textContent = 'Not required';
      apiKeyStatus.className = 'label-text-alt text-success';
      apiKeyInput.placeholder = 'No API key needed for local models';
      apiKeyInput.disabled = true;
      return;
    }
    
    // Re-enable API key input for models that need it
    apiKeyInput.disabled = false;
    
    const storedKey = getStoredApiKey(selectedModel);
    
    if (storedKey) {
      apiKeyStatus.textContent = 'Configured';
      apiKeyStatus.className = 'label-text-alt text-success';
      apiKeyInput.placeholder = '••••••••••••••••';
    } else {
      apiKeyStatus.textContent = 'Not configured';
      apiKeyStatus.className = 'label-text-alt text-warning';
      apiKeyInput.placeholder = 'Enter your API key';
    }
  }

  // Store API key securely
  function storeApiKey(model, key) {
    const modelInfo = MODEL_INFO[model];
    const encrypted = btoa(key); // Simple base64 encoding
    localStorage.setItem(`${modelInfo.provider}_api_key`, encrypted);
  }

  // Get stored API key
  function getStoredApiKey(model) {
    const modelInfo = MODEL_INFO[model];
    const encrypted = localStorage.getItem(`${modelInfo.provider}_api_key`);
    return encrypted ? atob(encrypted) : null;
  }

  // Load stored API key
  function loadStoredApiKey() {
    const selectedModel = modelSelect.value;
    const storedKey = getStoredApiKey(selectedModel);
    if (storedKey) {
      apiKeyInput.value = storedKey;
    } else {
      apiKeyInput.value = '';
    }
  }

  // Show/hide API key
  function toggleApiKeyVisibility() {
    const isPassword = apiKeyInput.type === 'password';
    apiKeyInput.type = isPassword ? 'text' : 'password';
    toggleApiKeyBtn.innerHTML = isPassword ? 
      '<i class="ti ti-eye-off"></i>' : 
      '<i class="ti ti-eye"></i>';
  }

  // Test model connection
  async function testModelConnection() {
    const selectedModel = modelSelect.value;
    const modelInfo = MODEL_INFO[selectedModel];
    const apiKey = apiKeyInput.value.trim();
    
    // For Ollama models, we don't need API key
    if (modelInfo.requiresApiKey !== false && !apiKey) {
      showConnectionStatus('error', 'Please enter an API key');
      return;
    }
    
    testConnectionBtn.disabled = true;
    testConnectionBtn.innerHTML = '<span class="loading loading-spinner loading-sm"></span> Testing...';
    showConnectionStatus('info', 'Testing connection...');
    
    try {
      const response = await fetch('/api/agent/test-model', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          model: selectedModel,
          api_key: apiKey || null  // Send null for Ollama models
        })
      });
      
      const data = await response.json();
      
      if (data.success) {
        showConnectionStatus('success', 'Connection successful!');
        storeApiKey(selectedModel, apiKey);
        updateApiKeyStatus();
      } else {
        showConnectionStatus('error', `Connection failed: ${data.error}`);
      }
    } catch (error) {
      showConnectionStatus('error', `Connection failed: ${error.message}`);
    } finally {
      testConnectionBtn.disabled = false;
      testConnectionBtn.innerHTML = '<i class="ti ti-plug"></i> Test';
    }
  }

  // Apply model settings
  async function applyModelSettings() {
    const selectedModel = modelSelect.value;
    const modelInfo = MODEL_INFO[selectedModel];
    const apiKey = apiKeyInput.value.trim();
    
    // For Ollama models, we don't need API key
    if (modelInfo.requiresApiKey !== false && !apiKey) {
      showConnectionStatus('error', 'Please enter an API key');
      return;
    }
    
    applyModelBtn.disabled = true;
    applyModelBtn.innerHTML = '<span class="loading loading-spinner loading-sm"></span> Applying...';
    
    try {
      const apiKeys = {};
      
      // Only add API key if the model requires it
      if (modelInfo.requiresApiKey !== false && apiKey) {
        apiKeys[modelInfo.provider] = apiKey;
      }
      
      const response = await fetch('/api/agent/switch-model', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          model: selectedModel,
          api_keys: apiKeys
        })
      });
      
      const data = await response.json();
      
      if (data.success) {
        currentModel = selectedModel;
        
        // Only store API key if the model requires it
        if (modelInfo.requiresApiKey !== false && apiKey) {
          storeApiKey(selectedModel, apiKey);
        }
        
        updateModelDisplay();
        showConnectionStatus('success', `Switched to ${modelInfo.display_name}!`);
        
        // Close modal after success
        setTimeout(() => {
          closeModelSettings();
        }, 1500);
      } else {
        showConnectionStatus('error', `Failed to switch model: ${data.error}`);
      }
    } catch (error) {
      showConnectionStatus('error', `Failed to switch model: ${error.message}`);
    } finally {
      applyModelBtn.disabled = false;
      applyModelBtn.innerHTML = '<i class="ti ti-check"></i> Apply';
    }
  }

  // Show connection status
  function showConnectionStatus(type, message) {
    connectionStatus.className = `alert mb-4`;
    connectionMessage.textContent = message;
    
    switch (type) {
      case 'success':
        connectionStatus.classList.add('alert-success');
        connectionStatus.innerHTML = '<i class="ti ti-check"></i><span>' + message + '</span>';
        break;
      case 'error':
        connectionStatus.classList.add('alert-error');
        connectionStatus.innerHTML = '<i class="ti ti-x"></i><span>' + message + '</span>';
        break;
      case 'info':
        connectionStatus.classList.add('alert-info');
        connectionStatus.innerHTML = '<i class="ti ti-info-circle"></i><span>' + message + '</span>';
        break;
    }
    
    connectionStatus.classList.remove('hidden');
  }

  // Open model settings
  function openModelSettings() {
    loadStoredApiKey();
    updateModelDescription();
    updateApiKeyStatus();
    connectionStatus.classList.add('hidden');
    modelSettingsModal.classList.add('modal-open');
  }

  // Close model settings
  function closeModelSettings() {
    modelSettingsModal.classList.remove('modal-open');
    connectionStatus.classList.add('hidden');
  }

  // Event listeners
  modelSettingsBtn.addEventListener('click', openModelSettings);
  modelSelect.addEventListener('change', () => {
    updateModelDescription();
    loadStoredApiKey();
    updateApiKeyStatus();
  });
  toggleApiKeyBtn.addEventListener('click', toggleApiKeyVisibility);
  testConnectionBtn.addEventListener('click', testModelConnection);
  applyModelBtn.addEventListener('click', applyModelSettings);

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', () => {
    initializeModelSettings();
  });

  // Memory state
  let currentSessionId = null;
  let sessions = [];
  let isMemoryEnabled = false;
  let lastVizCode = '';
  let selectedVizFile = '';





  function toggleAgentChat() {
    agentChatPopup.classList.toggle('hidden');
    if (agentChatPopup.classList.contains('hidden')) {
      agentIcon.classList.remove('ti-x');
      agentIcon.classList.add('ti-message-chatbot');
    } else {
      agentIcon.classList.remove('ti-message-chatbot');
      agentIcon.classList.add('ti-x');
    }
    saveState();
  }

  // --- Dragging & Resizing Logic ---
  let isDragging = false;
  let isResizing = false;
  let resizeDirection = '';
  let offsetX, offsetY, lastX, lastY;

  chatHeader.addEventListener('mousedown', (e) => {
    // Prevent starting a drag on the close button
    if (e.target.closest('button')) return;
    isDragging = true;
    offsetX = e.clientX - agentChatPopup.offsetLeft;
    offsetY = e.clientY - agentChatPopup.offsetTop;
    agentChatPopup.style.userSelect = 'none';
  });

  agentChatPopup.querySelectorAll('.resize-handle').forEach(handle => {
    handle.addEventListener('mousedown', (e) => {
        isResizing = true;
        resizeDirection = e.target.className.split(' ')[1];
        lastX = e.clientX;
        lastY = e.clientY;
        document.body.style.cursor = getComputedStyle(e.target).cursor;
        agentChatPopup.style.userSelect = 'none';
        e.stopPropagation();
        e.preventDefault();
    });
  });

  document.addEventListener('mousemove', (e) => {
    if (isDragging) {
        e.preventDefault();
        
        // Calculate new position
        let newLeft = e.clientX - offsetX;
        let newTop = e.clientY - offsetY;
        
        // Get popup dimensions
        const rect = agentChatPopup.getBoundingClientRect();
        const popupWidth = rect.width;
        const popupHeight = rect.height;
        
        // Get viewport dimensions
        const viewportWidth = window.innerWidth;
        const viewportHeight = window.innerHeight;
        
        // Apply boundary constraints
        // Ensure at least 50px of the popup is visible on each side
        const minVisible = 50;
        newLeft = Math.max(-popupWidth + minVisible, Math.min(newLeft, viewportWidth - minVisible));
        newTop = Math.max(0, Math.min(newTop, viewportHeight - minVisible));
        
        agentChatPopup.style.left = `${newLeft}px`;
        agentChatPopup.style.top = `${newTop}px`;
        agentChatPopup.style.bottom = 'auto';
        agentChatPopup.style.right = 'auto';
    } else if (isResizing) {
        e.preventDefault();
        
        const rect = agentChatPopup.getBoundingClientRect();
        let newWidth = rect.width;
        let newHeight = rect.height;
        let newLeft = rect.left;
        let newTop = rect.top;
        
        const deltaX = e.clientX - lastX;
        const deltaY = e.clientY - lastY;

        // Get viewport dimensions
        const viewportWidth = window.innerWidth;
        const viewportHeight = window.innerHeight;
        
        // Calculate new dimensions based on resize direction
        if (resizeDirection.includes('e')) {
            newWidth += deltaX;
            // Prevent resizing beyond viewport
            newWidth = Math.min(newWidth, viewportWidth - newLeft);
        }
        if (resizeDirection.includes('w')) {
            const potentialWidth = newWidth - deltaX;
            const potentialLeft = newLeft + deltaX;
            // Ensure left edge doesn't go beyond viewport
            if (potentialLeft >= 0 && potentialWidth >= 300) {
                newWidth = potentialWidth;
                newLeft = potentialLeft;
            }
        }
        if (resizeDirection.includes('s')) {
            newHeight += deltaY;
            // Prevent resizing beyond viewport
            newHeight = Math.min(newHeight, viewportHeight - newTop);
        }
        if (resizeDirection.includes('n')) {
            const potentialHeight = newHeight - deltaY;
            const potentialTop = newTop + deltaY;
            // Ensure top edge doesn't go beyond viewport
            if (potentialTop >= 0 && potentialHeight >= 200) {
                newHeight = potentialHeight;
                newTop = potentialTop;
            }
        }

        // Apply minimum and maximum size constraints
        const minWidth = 300;
        const minHeight = 200;
        const maxWidth = viewportWidth;
        const maxHeight = viewportHeight;
        
        newWidth = Math.max(minWidth, Math.min(newWidth, maxWidth));
        newHeight = Math.max(minHeight, Math.min(newHeight, maxHeight));
        
        // Update styles
        if (newWidth >= minWidth) {
            agentChatPopup.style.width = `${newWidth}px`;
            if (resizeDirection.includes('w')) agentChatPopup.style.left = `${newLeft}px`;
        }
        if (newHeight >= minHeight) {
            agentChatPopup.style.height = `${newHeight}px`;
            if (resizeDirection.includes('n')) agentChatPopup.style.top = `${newTop}px`;
        }
        
        lastX = e.clientX;
        lastY = e.clientY;
    }
  });

  document.addEventListener('mouseup', () => {
    if (isDragging || isResizing) {
      isDragging = false;
      isResizing = false;
      resizeDirection = '';
      agentChatPopup.style.userSelect = 'auto';
      document.body.style.cursor = 'auto';
      saveState();
    }
  });
  
  function addMessage(message, sender) {
      const chatClass = sender === 'user' ? 'chat-end' : 'chat-start';
      const bubbleClass = sender === 'user' ? 'chat-bubble-secondary' : 'chat-bubble-primary';
      
      const messageElement = document.createElement('div');
      messageElement.className = `chat ${chatClass}`;
      
      const bubble = document.createElement('div');
      bubble.className = `chat-bubble ${bubbleClass}`;
      
      // Create markdown container for proper styling
      const markdownContainer = document.createElement('div');
      markdownContainer.className = 'markdown-content';
      
      // Parse markdown using marked.js (simple like test-marked.html)
      try {
          if (typeof marked !== 'undefined' && marked.parse) {
              const rendered = marked.parse(message);
              markdownContainer.innerHTML = rendered;
              
              // Add copy buttons to code blocks after rendering
              addCopyButtonsToCodeBlocks(markdownContainer);
          } else {
              console.error('Marked.js library not available!');
              markdownContainer.innerHTML = message;
          }
      } catch (error) {
          console.error('Error parsing markdown:', error);
          markdownContainer.innerHTML = message;
      }
      
      bubble.appendChild(markdownContainer);
      
      // Add action buttons
      const buttonContainer = document.createElement('div');
      buttonContainer.className = 'message-buttons flex items-center space-x-1 mt-2 opacity-0 group-hover:opacity-100 transition-opacity';
      
      if (sender === 'user') {
          // Edit and resend button for user messages
          const editBtn = document.createElement('button');
          editBtn.className = 'edit-resend-btn btn btn-xs btn-ghost';
          editBtn.title = 'Edit and resend';
          editBtn.innerHTML = '<i class="ti ti-edit"></i>';
          buttonContainer.appendChild(editBtn);
      } else {
          // Copy answer button for agent messages
          const copyBtn = document.createElement('button');
          copyBtn.className = 'copy-answer-btn btn btn-xs btn-ghost';
          copyBtn.title = 'Copy answer';
          copyBtn.innerHTML = '<i class="ti ti-copy"></i>';
          buttonContainer.appendChild(copyBtn);
      }
      
      bubble.appendChild(buttonContainer);
      messageElement.classList.add('group'); // For hover effects
      messageElement.appendChild(bubble);
      chatBody.appendChild(messageElement);
      chatBody.scrollTop = chatBody.scrollHeight;
  }

  function setAgentStatus(ready) {
      if (ready) {
          chatInput.disabled = false;
          chatSendBtn.disabled = false;
          chatInput.placeholder = "Ask a question...";
      } else {
          chatInput.disabled = true;
          chatSendBtn.disabled = true;
          chatInput.placeholder = "Initializing agent...";
      }
  }

  async function checkAgentStatusLoop() {
      try {
          const response = await fetch('/api/agent/status');
          const data = await response.json();
          setAgentStatus(data.ready);
          
          if (data.ready) {
              // Check if memory features are available
              await checkMemoryFeatures();
          } else {
              setTimeout(checkAgentStatusLoop, 2500); // Poll again
          }
      } catch (e) {
          setAgentStatus(false);
          setTimeout(checkAgentStatusLoop, 2500); // Poll again on error
      }
  }

  async function checkMemoryFeatures() {
      try {
          // Try to access memory features
          const response = await fetch('/api/agent/sessions');
          if (response.ok) {
              isMemoryEnabled = true;
              sessionIndicator.classList.remove('hidden');
              await updateSessionInfo();
              await loadSessions();
          }
      } catch (e) {
          // Memory features not available, use basic mode
          isMemoryEnabled = false;
          sessionIndicator.classList.add('hidden');
      }
  }

  async function askAgent(question) {
    addMessage(question, 'user');
    chatInput.value = '';
    chatInput.disabled = true;
    chatSendBtn.disabled = true;
    
    // Create AbortController for this request
    currentAbortController = new AbortController();
    
    // Show stop button, hide send button
    chatSendBtn.classList.add('hidden');
    stopGenerationBtn.classList.remove('hidden');

    // If no current session and memory is enabled, start a new session
    if (isMemoryEnabled && !currentSessionId) {
      try {
        const response = await fetch('/api/agent/sessions/new', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await response.json();
        if (data.success) {
          currentSessionId = data.session_id;
          console.log('Started new session:', currentSessionId);
        }
      } catch (error) {
        console.error('Error starting new session:', error);
      }
    }

    // Create a new, empty message bubble for the agent's response
    const agentMessageElement = document.createElement('div');
    agentMessageElement.className = 'chat chat-start';
    const agentBubble = document.createElement('div');
    agentBubble.className = 'chat-bubble chat-bubble-primary';
    // Add a dedicated container for markdown content
    agentBubble.innerHTML = '<div class="markdown-content"><span class="blinking-cursor"></span></div>'; 
    agentMessageElement.appendChild(agentBubble);
    chatBody.appendChild(agentMessageElement);
    chatBody.scrollTop = chatBody.scrollHeight;

    let fullAnswer = '';
    let sources = [];

    try {
      const response = await fetch('/api/agent/ask', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ 
          question,
          sessionId: currentSessionId 
        }),
        signal: currentAbortController.signal
      });

      if (!response.ok) {
        const errorData = await response.json();
        throw new Error(errorData.error || 'Agent API error');
      }

      const reader = response.body.getReader();
      const decoder = new TextDecoder();
      let buffer = '';

      // Set up the content container
      const markdownContainer = agentBubble.querySelector('.markdown-content');
      markdownContainer.innerHTML = ''; // Remove blinking cursor

      while (true) {
        const { done, value } = await reader.read();
        if (done) {
          // Process any remaining buffer content
          if (buffer.trim()) {
            const lines = buffer.split('\n\n');
            for (const line of lines) {
              if (line.startsWith('data: ')) {
                const jsonStr = line.substring(6);
                try {
                  const event = JSON.parse(jsonStr);
                  if (event.type === 'chunk' && event.content) {
                    fullAnswer += event.content;
                  } else if (event.type === 'sources' && event.sources) {
                    sources = event.sources;
                  } else if (event.type === 'final_data') {
                    if (event.answer) fullAnswer = event.answer;
                    if (event.sources) sources = event.sources;
                  } else if (event.type === 'final') {
                    if (event.answer) fullAnswer = event.answer;
                    if (event.sources) sources = event.sources;
                  }
                } catch (e) {
                  console.warn('Failed to parse remaining buffer:', line, e);
                }
              }
            }
          }
          break;
        }

        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n\n');
        buffer = lines.pop(); // Keep the last, potentially incomplete line

        for (const line of lines) {
          if (line.startsWith('data: ')) {
            const jsonStr = line.substring(6);
            try {
                const event = JSON.parse(jsonStr);

                if (event.type === 'chunk' && event.content) {
                    fullAnswer += event.content;
                    
                    try {
                        if (typeof marked !== 'undefined' && marked.parse) {
                            const rendered = marked.parse(fullAnswer);
                            markdownContainer.innerHTML = rendered + '<span class="blinking-cursor"></span>';
                            
                            // Add copy buttons to code blocks during streaming
                            addCopyButtonsToCodeBlocks(markdownContainer);
                        } else {
                            markdownContainer.innerHTML = fullAnswer + '<span class="blinking-cursor"></span>';
                        }
                    } catch (error) {
                        console.error('Error during streaming markdown:', error);
                        markdownContainer.innerHTML = fullAnswer + '<span class="blinking-cursor"></span>';
                    }
                    chatBody.scrollTop = chatBody.scrollHeight;
                } else if (event.type === 'message' && event.content) {
                    // Handle workflow planning messages
                    fullAnswer += event.content;
                    
                    try {
                        if (typeof marked !== 'undefined' && marked.parse) {
                            const rendered = marked.parse(fullAnswer);
                            markdownContainer.innerHTML = rendered + '<span class="blinking-cursor"></span>';
                            
                            // Add copy buttons to code blocks during streaming
                            addCopyButtonsToCodeBlocks(markdownContainer);
                        } else {
                            markdownContainer.innerHTML = fullAnswer + '<span class="blinking-cursor"></span>';
                        }
                    } catch (error) {
                        console.error('Error during streaming markdown:', error);
                        markdownContainer.innerHTML = fullAnswer + '<span class="blinking-cursor"></span>';
                    }
                    chatBody.scrollTop = chatBody.scrollHeight;
                } else if (event.type === 'workflow_plan' && event.plan) {
                    // Store workflow plan for potential building
                    window.currentWorkflowPlan = event.plan;
                    console.log('Received workflow plan:', event.plan);
                } else if (event.type === 'build_workflow' && (event.workflow || event.workflow_data)) {
                    // Build workflow on canvas
                    const workflowData = event.workflow || event.workflow_data;
                    handleWorkflowBuild(workflowData);
            } else if (event.type === 'viz_code' && event.code) {
                lastVizCode = event.code;
                renderVizCodeCard(event.code);
                } else if (event.type === 'sources' && event.sources) {
                    sources = event.sources;
                } else if (event.type === 'final_data') {
                    // In our new flow, final data is also handled via chunks and sources events
                    // But we can grab the final answer here if needed.
                    if (event.answer) fullAnswer = event.answer;
                    if (event.sources) sources = event.sources;
                } else if (event.type === 'final') {
                    // Handle final event type
                    if (event.answer) fullAnswer = event.answer;
                    if (event.sources) sources = event.sources;
                } else if (event.type === 'error') {
                    throw new Error(event.error);
                }
            } catch (e) {
                console.error('Failed to parse stream event:', jsonStr, e);
            }
          }
        }
      }

      // Final update to the bubble without the cursor (simple like test-marked.html)
      let finalMarkdown;
      try {
          if (typeof marked !== 'undefined' && marked.parse) {
              finalMarkdown = marked.parse(fullAnswer);
          } else {
              console.error('Marked.js not available');
              finalMarkdown = fullAnswer;
          }
      } catch (error) {
          console.error('Error parsing final markdown:', error);
          finalMarkdown = fullAnswer;
      }
      
      let sourcesHtmlContent = '';
      if (sources && sources.length > 0) {
        let sourcesHtml = '<hr class="my-2 border-base-300/50"><div class="text-xs mt-2 opacity-70"><strong>Sources:</strong><ul class="list-disc list-inside">';
        let hasValidSource = false;
        sources.forEach(source => {
            if (source && source.source) {
                sourcesHtml += `<li>${source.source}</li>`;
                hasValidSource = true;
            }
        });
        sourcesHtml += '</ul></div>';
        
        if (hasValidSource) {
            sourcesHtmlContent = sourcesHtml;
        }
      }
      markdownContainer.innerHTML = finalMarkdown + sourcesHtmlContent;
      
      // Add copy buttons to code blocks in final rendering
      addCopyButtonsToCodeBlocks(markdownContainer);
      
      chatBody.scrollTop = chatBody.scrollHeight;
      
      // Update session info if memory is enabled
      if (isMemoryEnabled) {
        updateSessionInfo();
      }
      
      saveState();

    } catch (error) {
      console.error('Error asking agent:', error);
      
      if (error.name === 'AbortError') {
        // Request was aborted by user
        agentBubble.classList.add('chat-bubble-warning');
        agentBubble.innerHTML = `Generation stopped by user.`;
      } else {
      agentBubble.classList.add('chat-bubble-error');
      agentBubble.innerHTML = `Sorry, I encountered an error: ${error.message}`;
      }
      saveState();
    } finally {
      chatInput.disabled = false;
      chatSendBtn.disabled = false;
      chatInput.focus();
      
      // Restore button states
      stopGenerationBtn.classList.add('hidden');
      chatSendBtn.classList.remove('hidden');
      
      // Clear AbortController
      currentAbortController = null;
    }
  }

  chatSendBtn.addEventListener('click', () => {
    const question = chatInput.value.trim();
    if (question) {
      askAgent(question);
    }
  });

  // Stop generation button event listener
  stopGenerationBtn.addEventListener('click', () => {
