<script src="/js/components.js"></script>
<script src="/js/workflow-builder.js?v=2024"></script>
<script src="/js/workflow-debug.js?v=2024"></script>
<script>
  // Enhanced workflow UI functions
  function updateNodeCount() {
    const nodeCount = document.querySelectorAll('.workflow-node').length;
    const nodeCountBadge = document.getElementById('node-count');
    if (nodeCountBadge) {
      nodeCountBadge.textContent = `Nodes: ${nodeCount}`;
    }
  }

  function updateConnectionCount() {
    const connectionCount = document.querySelectorAll('.workflow-connection').length;
    const connectionCountBadge = document.getElementById('connection-count');
    if (connectionCountBadge) {
      connectionCountBadge.textContent = `Connections: ${connectionCount}`;
    }
  }

  function updateComponentCounts() {
    // Update tool count
    const toolCount = document.querySelectorAll('#tool-components .component-item').length;
    const toolCountBadge = document.getElementById('tool-count');
    if (toolCountBadge) {
      toolCountBadge.textContent = toolCount;
    }

    // Update viz count
    const vizCount = document.querySelectorAll('#viz-components .component-item').length;
    const vizCountBadge = document.getElementById('viz-count');
    if (vizCountBadge) {
      vizCountBadge.textContent = vizCount;
    }
  }

  function toggleGrid() {
    const canvas = document.getElementById('workflow-canvas');
    const gridElement = canvas.querySelector('.absolute.inset-0.opacity-30');
    if (gridElement) {
      gridElement.style.display = gridElement.style.display === 'none' ? 'block' : 'none';
    }
  }

  function zoomToFit() {
    const canvas = document.getElementById('workflow-canvas');
    const nodes = canvas.querySelectorAll('.workflow-node');
    if (nodes.length === 0) return;

    // Calculate bounding box of all nodes
    let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
    nodes.forEach(node => {
      const rect = node.getBoundingClientRect();
      const canvasRect = canvas.getBoundingClientRect();
      const x = rect.left - canvasRect.left;
      const y = rect.top - canvasRect.top;
      minX = Math.min(minX, x);
      minY = Math.min(minY, y);
      maxX = Math.max(maxX, x + rect.width);
      maxY = Math.max(maxY, y + rect.height);
    });

    // Center the view on the nodes
    const centerX = (minX + maxX) / 2;
    const centerY = (minY + maxY) / 2;
    const canvasWidth = canvas.offsetWidth;
    const canvasHeight = canvas.offsetHeight;

    // Smooth scroll to center
    canvas.scrollTo({
      left: centerX - canvasWidth / 2,
      top: centerY - canvasHeight / 2,
      behavior: 'smooth'
    });
  }

  function resetZoom() {
    const canvas = document.getElementById('workflow-canvas');
    canvas.scrollTo({ left: 0, top: 0, behavior: 'smooth' });
  }

  // ===== Component Sidebar Toggle =====
  let sidebarCollapsed = false;
  
  function toggleComponentSidebar() {
    const sidebar = document.getElementById('component-sidebar');
    const collapseBtn = document.getElementById('sidebar-collapse-btn');
    const expandBtn = document.getElementById('sidebar-expand-btn');
    
    sidebarCollapsed = !sidebarCollapsed;
    
    if (sidebarCollapsed) {
      // Collapse sidebar
      sidebar.style.width = '0px';
      sidebar.style.overflow = 'hidden';
      
      // Hide collapse button (in sidebar)
      if (collapseBtn) collapseBtn.style.display = 'none';
      
      // Show expand button (in canvas toolbar)
      if (expandBtn) expandBtn.classList.remove('hidden');
    } else {
      // Expand sidebar
      sidebar.style.width = '320px';
      sidebar.style.overflow = 'visible';
      
      // Show collapse button (in sidebar)
      if (collapseBtn) collapseBtn.style.display = 'flex';
      
      // Hide expand button (in canvas toolbar)
      if (expandBtn) expandBtn.classList.add('hidden');
    }
    
    // Update connections after sidebar toggle
    if (window.workflowBuilder && window.workflowBuilder.updateAllConnections) {
      setTimeout(() => {
        window.workflowBuilder.updateAllConnections();
      }, 350);
    }
  }

  // ===== Canvas Zoom Functions =====
  let canvasZoomLevel = 1.0;
  
  function zoomCanvas(delta) {
    const canvas = document.getElementById('workflow-canvas');
    const zoomDisplay = document.getElementById('canvas-zoom-level');
    
    canvasZoomLevel = Math.max(0.3, Math.min(3.0, canvasZoomLevel + delta));
    canvas.style.transform = `scale(${canvasZoomLevel})`;
    
    // Update display
    zoomDisplay.textContent = `${Math.round(canvasZoomLevel * 100)}%`;
    
    // Update connections after zoom
    if (window.workflowBuilder && window.workflowBuilder.updateAllConnections) {
      setTimeout(() => {
        window.workflowBuilder.updateAllConnections();
      }, 100);
    }
  }
  
  function resetCanvasZoom() {
    canvasZoomLevel = 1.0;
    const canvas = document.getElementById('workflow-canvas');
    const zoomDisplay = document.getElementById('canvas-zoom-level');
    
    canvas.style.transform = 'scale(1)';
    zoomDisplay.textContent = '100%';
    
    // Update connections after reset
    if (window.workflowBuilder && window.workflowBuilder.updateAllConnections) {
      setTimeout(() => {
        window.workflowBuilder.updateAllConnections();
      }, 100);
    }
  }

  // Mouse wheel zoom for canvas
  function setupCanvasWheelZoom() {
    const scrollContainer = document.getElementById('canvas-scroll-container');
    if (!scrollContainer) return;
    
    scrollContainer.addEventListener('wheel', (e) => {
      // Ctrl/Cmd + Wheel for zoom
      if (e.ctrlKey || e.metaKey) {
        e.preventDefault();
        const delta = e.deltaY > 0 ? -0.05 : 0.05;
        zoomCanvas(delta);
      }
    }, { passive: false });
  }

  // Center canvas on initial load
  function centerCanvas() {
    const scrollContainer = document.getElementById('canvas-scroll-container');
    const canvas = document.getElementById('workflow-canvas');
    
    if (scrollContainer && canvas) {
      // Calculate center position
      const containerWidth = scrollContainer.clientWidth;
      const containerHeight = scrollContainer.clientHeight;
      const canvasWidth = canvas.offsetWidth;
      const canvasHeight = canvas.offsetHeight;
      
      // Scroll to center
      scrollContainer.scrollLeft = (canvasWidth - containerWidth) / 2;
      scrollContainer.scrollTop = (canvasHeight - containerHeight) / 2;
    }
  }

  function undoLastAction() {
    if (window.workflowBuilder && window.workflowBuilder.undo) {
      window.workflowBuilder.undo();
    } else {
      console.log('Undo function not yet implemented');
    }
  }

  function redoLastAction() {
    if (window.workflowBuilder && window.workflowBuilder.redo) {
      window.workflowBuilder.redo();
    } else {
      console.log('Redo function not yet implemented');
    }
  }

  // Component search functionality
  function setupComponentSearch() {
    const searchInput = document.getElementById('component-search');
    if (!searchInput) return;

    searchInput.addEventListener('input', function(e) {
      const searchTerm = e.target.value.toLowerCase();
      const componentItems = document.querySelectorAll('.component-item');
      
      componentItems.forEach(item => {
        const text = item.textContent.toLowerCase();
        const shouldShow = text.includes(searchTerm);
        item.style.display = shouldShow ? 'flex' : 'none';
        
        // Add highlight effect
        if (searchTerm && shouldShow && searchTerm.length > 0) {
          item.classList.add('bg-primary/10', 'border-primary/30');
        } else {
          item.classList.remove('bg-primary/10', 'border-primary/30');
        }
      });
    });
  }

  // Workflow template functions

  function showTemplateMessage(message, type = 'info') {
    const alertClass = type === 'success' ? 'alert-success' : type === 'error' ? 'alert-error' : 'alert-info';
    const iconClass = type === 'success' ? 'ti-check' : type === 'error' ? 'ti-x' : 'ti-info-circle';
    
    const alert = document.createElement('div');
    alert.className = `alert ${alertClass} fixed top-20 right-4 z-50 w-96 shadow-lg`;
    alert.innerHTML = `
      <i class="ti ${iconClass}"></i>
      <span>${message}</span>
      <button class="btn btn-sm btn-circle btn-ghost ml-auto" onclick="this.parentElement.remove()">
        <i class="ti ti-x"></i>
      </button>
    `;
    
    document.body.appendChild(alert);
    
    // Auto remove after 3 seconds
    setTimeout(() => {
      if (alert.parentElement) {
        alert.remove();
      }
    }, 3000);
  }

  // Progress visualization functions
  async function showWorkflowProgress() {
    // Check if there's a recent workflow job to show progress for
    const lastJobId = window.workflowBuilder?.lastJobId;
    
    if (lastJobId) {
      // Show progress for the last executed workflow
      console.log('🔍 Showing progress for job:', lastJobId);
      try {
        await window.workflowBuilder.showProgressModal(lastJobId);
        return;
      } catch (error) {
        console.error('Error showing job progress:', error);
        // Fall through to show static progress if job progress fails
      }
    }
    
    // Show static workflow information if no active job
    const modal = document.createElement('dialog');
    modal.className = 'modal';
    
    // Get workflow jobs list
    let workflowJobs = [];
    try {
      const response = await fetch('/api/workflow-jobs');
      if (response.ok) {
        workflowJobs = await response.json();
      }
    } catch (error) {
      console.log('Could not fetch workflow jobs:', error);
    }
    
    modal.innerHTML = `
      <div class="modal-box w-11/12 max-w-4xl bg-gradient-to-br from-base-100 to-base-200">
        <div class="flex items-center justify-between mb-6">
          <h3 class="font-bold text-xl flex items-center">
            <i class="ti ti-activity mr-3 text-info"></i>
            Workflow Progress & History
          </h3>
          <button class="btn btn-sm btn-circle btn-ghost" onclick="this.closest('dialog').close()">
            <i class="ti ti-x"></i>
          </button>
        </div>
        
        <div class="space-y-4">
          <!-- Current Workflow Stats -->
          <div class="stats shadow w-full">
            <div class="stat">
              <div class="stat-figure text-primary">
                <i class="ti ti-nodes text-2xl"></i>
              </div>
              <div class="stat-title">Canvas Nodes</div>
              <div class="stat-value text-primary">${document.querySelectorAll('.workflow-node').length}</div>
            </div>
            
            <div class="stat">
              <div class="stat-figure text-secondary">
                <i class="ti ti-git-branch text-2xl"></i>
              </div>
              <div class="stat-title">Connections</div>
              <div class="stat-value text-secondary">${document.querySelectorAll('.workflow-connection').length}</div>
            </div>
            
            <div class="stat">
              <div class="stat-figure text-accent">
                <i class="ti ti-history text-2xl"></i>
              </div>
              <div class="stat-title">Job History</div>
              <div class="stat-value text-accent">${workflowJobs.length}</div>
            </div>
          </div>
          
