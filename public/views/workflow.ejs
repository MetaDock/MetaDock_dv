  // Initialize WorkflowBuilder when DOM is ready (single instance)
  let workflowBuilderInitialized = false;
  
  function initializeWorkflowBuilder() {
    if (workflowBuilderInitialized) {
      console.log('WorkflowBuilder initialization already attempted, skipping...');
      return;
    }
    
    workflowBuilderInitialized = true;
    
    try {
      if (window.workflowBuilder) {
        console.log('WorkflowBuilder already exists, skipping...');
        return;
      }
      
      if (typeof WorkflowBuilder !== 'undefined') {
        window.workflowBuilder = new WorkflowBuilder();
        console.log('WorkflowBuilder initialized successfully (EJS)');
        
        // Check for pending workflow from Agent
        setTimeout(() => {
          const pendingWorkflow = sessionStorage.getItem('pendingWorkflow');
          if (pendingWorkflow) {
            try {
              const workflowData = JSON.parse(pendingWorkflow);
              sessionStorage.removeItem('pendingWorkflow');
              
              console.log('🤖 Building workflow from Agent:', workflowData);
              
              // Clear existing workflow
              window.workflowBuilder.clearCanvas();
              
              // Add nodes and create ID mapping
              const nodeIdMapping = new Map(); // Maps Agent IDs to actual node IDs
              
              workflowData.nodes.forEach(nodeData => {
                try {
                  const node = window.workflowBuilder.createNode(
                    nodeData.type,
                    nodeData.component,
                    nodeData.x,
                    nodeData.y
                  );
                  
                  // Check if node was created successfully
                  if (!node || !node.id) {
                    console.error('Failed to create node:', nodeData);
                    return;
                  }
                  
                  // Map Agent ID to actual node ID
                  nodeIdMapping.set(nodeData.id, node.id);
                  console.log(`📍 Node ID mapping: ${nodeData.id} → ${node.id}`);
                  
                  // Configure node parameters
                  if (nodeData.config && Object.keys(nodeData.config).length > 0) {
                    const nodeElement = document.getElementById(node.id);
                    if (nodeElement) {
                      // Store config in node data
                      const nodeMapEntry = window.workflowBuilder.nodes.get(node.id);
                      if (nodeMapEntry) {
                        nodeMapEntry.config = nodeData.config;
                      }
                      
                      // Update node display to show it's configured
                      const configBtn = nodeElement.querySelector('.config-btn');
                      if (configBtn) {
                        configBtn.classList.remove('btn-outline');
                        configBtn.classList.add('btn-primary');
                        configBtn.innerHTML = '<i class="ti ti-settings-filled mr-1"></i>Configured';
                      }
                    }
                  }
                } catch (error) {
                  console.error('Error creating node:', nodeData, error);
                }
              });
              
              // Store the mapping for connection creation
              window.agentNodeIdMapping = nodeIdMapping;
              
              // Add connections after a longer delay to ensure nodes are fully initialized
              setTimeout(() => {
                console.log('🔗 Creating connections from Agent workflow:', workflowData.connections);
                
                if (!workflowData.connections || workflowData.connections.length === 0) {
                  console.warn('⚠️ No connections found in Agent workflow data');
                  return;
                }
                
                workflowData.connections.forEach((connData, index) => {
                  try {
                    console.log(`🔗 Creating connection ${index + 1}:`, connData);
                    
                    // Validate connection data
                    if (!connData.fromNode || !connData.toNode) {
                      console.error('❌ Invalid connection data - missing nodes:', connData);
                      return;
                    }
                    
                    if (!connData.fromPort || !connData.toPort) {
                      console.error('❌ Invalid connection data - missing ports:', connData);
                      return;
                    }
                    
                    // Map Agent IDs to actual node IDs
                    const actualFromNodeId = nodeIdMapping.get(connData.fromNode);
                    const actualToNodeId = nodeIdMapping.get(connData.toNode);
                    
                    if (!actualFromNodeId) {
                      console.error(`❌ From node ID mapping not found: ${connData.fromNode}`);
                      return;
                    }
                    
                    if (!actualToNodeId) {
                      console.error(`❌ To node ID mapping not found: ${connData.toNode}`);
                      return;
                    }
                    
                    console.log(`🔄 ID mapping: ${connData.fromNode} → ${actualFromNodeId}, ${connData.toNode} → ${actualToNodeId}`);
                    
                    // Verify nodes exist in DOM
                    const fromNodeElement = document.getElementById(actualFromNodeId);
                    const toNodeElement = document.getElementById(actualToNodeId);
                    
                    if (!fromNodeElement) {
                      console.error(`❌ From node not found in DOM: ${actualFromNodeId}`);
                      return;
                    }
                    
                    if (!toNodeElement) {
                      console.error(`❌ To node not found in DOM: ${actualToNodeId}`);
                      return;
                    }
                    
                    console.log(`✅ Nodes verified - From: ${actualFromNodeId}, To: ${actualToNodeId}`);
                    
                    const result = window.workflowBuilder.createConnection(
                      actualFromNodeId,
                      connData.fromPort,
                      actualToNodeId,
                      connData.toPort
                    );
                    
                    console.log(`✅ Connection ${index + 1} created successfully:`, result);
                    
                  } catch (error) {
                    console.error(`❌ Error creating connection ${index + 1}:`, connData, error);
                  }
                });
                
                // Update canvas placeholder
                window.workflowBuilder.updateCanvasPlaceholder();
                
                // Show success message
                const successMsg = document.createElement('div');
                successMsg.className = 'alert alert-success fixed top-20 right-4 z-50 w-96';
                successMsg.innerHTML = `
                  <div class="flex items-center">
                    <i class="ti ti-robot mr-2"></i>
                    <div>
                      <div class="font-semibold">Agent Built Your Workflow!</div>
                      <div class="text-sm opacity-90">The workflow has been created based on your conversation.</div>
                    </div>
                  </div>
                `;
                document.body.appendChild(successMsg);
                
                // Auto-remove success message
                setTimeout(() => {
                  if (successMsg.parentNode) {
                    successMsg.remove();
                  }
                }, 8000);
                
              }, 1000); // Increased delay to ensure nodes are fully initialized
              
            } catch (error) {
              console.error('Error loading pending workflow:', error);
              sessionStorage.removeItem('pendingWorkflow');
            }
          }
        }, 1000);
        
      } else {
        console.error('WorkflowBuilder class not found');
      }
    } catch (error) {
      console.error('Failed to initialize WorkflowBuilder:', error);
    }
  }

  // Global functions for conda environment management
  async function loadCondaEnvironments(paramId) {
    console.log('🐍 Loading conda environments for:', paramId);
    
    const selectElement = document.getElementById(paramId + '_select');
    if (!selectElement) {
      console.error('Select element not found:', paramId + '_select');
      return;
    }
    
    // Show loading state
    selectElement.innerHTML = '<option value="">Loading...</option>';
    selectElement.disabled = true;
    
    try {
      const response = await fetch('/api/conda-environments');
      const data = await response.json();
      
      if (data.success && data.environments) {
        console.log('✅ Found conda environments:', data.environments);
        
        // Clear loading state
        selectElement.innerHTML = '<option value="">Select conda environment...</option>';
        
        // Add environments to dropdown
        data.environments.forEach(env => {
          const option = document.createElement('option');
          option.value = env.name;
          option.textContent = env.name + (env.active ? ' (Currently Active)' : '');
          if (env.active) {
            option.style.fontWeight = 'bold';
            option.style.color = '#059669';
          }
          selectElement.appendChild(option);
        });
        
        // Set default value if available
        const inputElement = document.getElementById(paramId);
        if (inputElement && inputElement.value) {
          selectElement.value = inputElement.value;
        }
        
        console.log(`✅ Loaded ${data.environments.length} conda environments`);
      } else {
        throw new Error(data.error || 'Failed to load environments');
      }
    } catch (error) {
      console.error('❌ Error loading conda environments:', error);
      
      // Add common environment options as fallback
      selectElement.innerHTML = `
        <option value="">❌ Auto-load failed, select common environment or input manually</option>
        <option value="base">base (Default Environment)</option>
        <option value="spades_env">spades_env</option>
        <option value="quast_env">quast_env</option>
        <option value="biotools">biotools</option>
        <option value="bioinformatics">bioinformatics</option>
      `;
      
      // Show detailed error message
      const label = selectElement.closest('.form-control')?.querySelector('.label-text-alt');
      if (label) {
        let errorMsg = '❌ Unable to auto-load environment list.';
        
        // Parse error details
        if (error.message.includes('Conda command failed')) {
          errorMsg += ' Conda command execution failed, conda may not be installed or not in PATH.';
        } else if (error.message.includes('SSH connection failed')) {
          errorMsg += ' SSH connection failed, please check server connection.';
        } else {
          errorMsg += ' Please check server connection and conda installation.';
        }
        
        errorMsg += ' You can select common environments from above or input manually.';
        
        label.innerHTML = errorMsg;
        label.style.color = '#ef4444';
      }
    } finally {
      selectElement.disabled = false;
    }
  }

