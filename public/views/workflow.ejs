  function populateProgressList() {
    const progressList = document.getElementById('progress-list');
    if (!progressList) return;
    
    const nodes = document.querySelectorAll('.workflow-node');
    progressList.innerHTML = '';
    
    nodes.forEach((node, index) => {
      const nodeType = node.getAttribute('data-type') || 'unknown';
      const component = node.getAttribute('data-component') || 'unknown';
      const status = node.classList.contains('success') ? 'success' : 
                   node.classList.contains('error') ? 'error' :
                   node.classList.contains('loading') ? 'loading' : 'pending';
      
      const statusIcon = status === 'success' ? 'ti-check text-success' :
                        status === 'error' ? 'ti-x text-error' :
                        status === 'loading' ? 'ti-loader text-warning' : 'ti-clock text-base-content/50';
      
      const statusText = status === 'success' ? 'Completed' :
                        status === 'error' ? 'Failed' :
                        status === 'loading' ? 'Running' : 'Pending';
      
      const progressItem = document.createElement('div');
      progressItem.className = 'flex items-center justify-between p-3 bg-base-200 rounded-lg';
      progressItem.innerHTML = `
        <div class="flex items-center gap-3">
          <i class="ti ${statusIcon}"></i>
          <div>
            <div class="font-medium">${component}</div>
            <div class="text-sm text-base-content/70">${nodeType}</div>
          </div>
        </div>
        <div class="badge badge-outline">${statusText}</div>
      `;
      
      progressList.appendChild(progressItem);
    });
  }

