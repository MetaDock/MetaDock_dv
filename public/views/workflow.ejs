  // Function to manually fix a connection with correct calculation
  function manualFixConnection() {
    if (!window.workflowBuilder) {
      alert('WorkflowBuilder not initialized');
      return;
    }
    
    const connections = window.workflowBuilder.connections;
    connections.forEach((conn, connId) => {
      console.log(`Manually fixing connection ${connId}`);
      
      const fromNode = document.getElementById(conn.fromNode);
      const toNode = document.getElementById(conn.toNode);
      
      // Find the correct ports: from should be output, to should be input
      const fromPort = fromNode?.querySelector(`[data-port="${conn.fromPort}"][data-type="output"]`);
      const toPort = toNode?.querySelector(`[data-port="${conn.toPort}"][data-type="input"]`);
      const pathElement = document.getElementById(connId);
      
      if (fromPort && toPort && pathElement) {
        const canvas = document.getElementById('workflow-canvas');
        const rect = canvas.getBoundingClientRect();
        const fromRect = fromPort.getBoundingClientRect();
        const toRect = toPort.getBoundingClientRect();
        
        const fromX = fromRect.left + fromRect.width / 2 - rect.left;
        const fromY = fromRect.top + fromRect.height / 2 - rect.top;
        const toX = toRect.left + toRect.width / 2 - rect.left;
        const toY = toRect.top + toRect.height / 2 - rect.top;
        
        // Apply the new calculation directly
        const distance = Math.abs(toX - fromX);
        const controlOffset = Math.max(100, distance * 0.5);
        
        const fromType = fromPort.dataset.type;
        const toType = toPort.dataset.type;
        
        let path;
        if (fromType === 'output' && toType === 'input') {
          const controlX1 = fromX + controlOffset;
          const controlX2 = toX - controlOffset;
          path = `M ${fromX} ${fromY} C ${controlX1} ${fromY} ${controlX2} ${toY} ${toX} ${toY}`;
        } else if (fromType === 'input' && toType === 'output') {
          const controlX1 = fromX - controlOffset;
          const controlX2 = toX + controlOffset;
          path = `M ${fromX} ${fromY} C ${controlX1} ${fromY} ${controlX2} ${toY} ${toX} ${toY}`;
        } else {
          const controlX = (fromX + toX) / 2;
          path = `M ${fromX} ${fromY} C ${controlX} ${fromY} ${controlX} ${toY} ${toX} ${toY}`;
        }
        
        console.log('Calculated new path:', path);
        console.log('Old path was:', pathElement.getAttribute('d'));
        
        pathElement.setAttribute('d', path);
        
        console.log('Path updated to:', pathElement.getAttribute('d'));
      }
    });
  }
  
