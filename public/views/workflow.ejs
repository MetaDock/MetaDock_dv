  function createSpadesQuastWorkflow() {
    console.log('🧬 Creating SPAdes + QUAST workflow...');
    
    if (window.workflowBuilder) {
      try {
        // Clear canvas first
        window.workflowBuilder.clearCanvas();
        
        // Create input files for paired-end reads
        window.workflowBuilder.createNode('file-input', 'server-file', 50, 100);
        window.workflowBuilder.createNode('file-input', 'server-file', 50, 200);
        
        // Create SPAdes tool
        window.workflowBuilder.createNode('tool', 'spades', 300, 150);
        
        // Create QUAST tool
        window.workflowBuilder.createNode('tool', 'quast', 600, 150);
        
        // Create output folder
        window.workflowBuilder.createNode('file-output', 'server-folder', 850, 150);
        
        // Auto-connect the workflow after a short delay
        setTimeout(() => {
          try {
            console.log('🔗 Auto-connecting workflow...');
            
            // Get all nodes
            const nodes = document.querySelectorAll('.workflow-node');
            let input1, input2, spades, quast, output;
            
            nodes.forEach(node => {
              const type = node.getAttribute('data-type');
              const component = node.getAttribute('data-component');
              
              if (type === 'file-input' && component === 'server-file') {
                if (!input1) input1 = node;
                else input2 = node;
              } else if (type === 'tool' && component === 'spades') {
                spades = node;
              } else if (type === 'tool' && component === 'quast') {
                quast = node;
              } else if (type === 'file-output') {
                output = node;
              }
            });
            
            if (input1 && input2 && spades && quast && output) {
              // Connect input1 to spades reads_1
              window.workflowBuilder.createConnection(input1.id, 'file', spades.id, 'reads_1');
              
              // Connect input2 to spades reads_2
              window.workflowBuilder.createConnection(input2.id, 'file', spades.id, 'reads_2');
              
              // Connect spades contigs to quast contigs
              window.workflowBuilder.createConnection(spades.id, 'contigs', quast.id, 'contigs');
              
              // Connect quast report to output
              window.workflowBuilder.createConnection(quast.id, 'report', output.id, 'file');
              
              console.log('✅ Workflow auto-connected successfully!');
            }
          } catch (error) {
            console.error('Error auto-connecting workflow:', error);
          }
        }, 500);
        
        console.log('✅ SPAdes + QUAST workflow created!');
        console.log('📝 Next steps:');
        console.log('   1. Select left.fastq.gz for first input');
        console.log('   2. Select right.fastq.gz for second input');
        console.log('   3. Configure parameters for both tools');
        console.log('   4. Run workflow!');
        
        // Show hint
        alert('🧬 SPAdes + QUAST workflow created and connected!\n\nNext steps:\n1. Select left.fastq.gz and right.fastq.gz files\n2. Configure tool parameters (conda environments, output paths)\n3. Run workflow!');
        
      } catch (error) {
        console.error('❌ Error creating workflow:', error);
      }
    } else {
      console.error('❌ WorkflowBuilder not found!');
    }
  }

