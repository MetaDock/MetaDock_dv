  function getRelativeTime(dateString) {
      const now = new Date();
      const date = new Date(dateString);
      const diffMs = now - date;
      const diffMins = Math.floor(diffMs / 60000);
      const diffHours = Math.floor(diffMs / 3600000);
      const diffDays = Math.floor(diffMs / 86400000);

      if (diffMins < 1) return 'just now';
      if (diffMins < 60) return `${diffMins}m ago`;
      if (diffHours < 24) return `${diffHours}h ago`;
      if (diffDays < 7) return `${diffDays}d ago`;
      return date.toLocaleDateString();
  }

  async function loadSessions() {
      if (!isMemoryEnabled) return;
      
      try {
          sessionList.innerHTML = `
              <div class="text-center py-8 opacity-60">
                  <i class="ti ti-loading animate-spin text-2xl mb-2"></i>
                  <p class="text-sm">Loading chat history...</p>
              </div>
          `;
          
          const response = await fetch('/api/agent/sessions');
          const data = await response.json();
          sessions = data.sessions || [];
          
          renderSessions();
      } catch (error) {
          console.error('Error loading sessions:', error);
          sessionList.innerHTML = `
              <div class="text-center py-8 text-error">
                  <i class="ti ti-alert-circle text-2xl mb-2"></i>
                  <p class="text-sm">Error loading chat history</p>
              </div>
          `;
      }
  }

  function renderSessions() {
      if (sessions.length === 0) {
          sessionList.innerHTML = `
              <div class="text-center py-8 opacity-60">
                  <i class="ti ti-message-circle text-4xl mb-2"></i>
                  <p class="text-sm">No chat history yet</p>
                  <p class="text-xs">Start a conversation to see it here</p>
              </div>
          `;
          return;
      }

      const sessionsHtml = sessions.map(session => {
          const isActive = session.session_id === currentSessionId;
          const title = session.title || 'New Conversation';
          const createdDate = new Date(session.created_at).toLocaleDateString();
          const relativeTime = getRelativeTime(session.last_updated);
          
          return `
              <div class="session-item ${isActive ? 'bg-primary/10 border-primary' : 'hover:bg-base-200'} 
                   border rounded-lg p-3 mb-2 cursor-pointer transition-all duration-200" 
                   data-session-id="${session.session_id}">
                  <div class="flex items-start justify-between">
                      <div class="flex-1 min-w-0 ${!isActive ? 'load-session-trigger' : ''}" style="cursor: ${!isActive ? 'pointer' : 'default'}">
                          <div class="font-medium text-sm truncate mb-1" title="${title}">
                              ${isActive ? '<i class="ti ti-message-circle mr-1"></i>' : ''}${title}
                          </div>
                          <div class="text-xs opacity-60">${session.message_count} messages • ${relativeTime}</div>
                      </div>
                      <div class="flex gap-1 ml-2">
                          <button class="btn btn-xs btn-ghost btn-circle delete-session opacity-60 hover:opacity-100" title="Delete">
                              <i class="ti ti-trash text-xs"></i>
                          </button>
                      </div>
                  </div>
              </div>
          `;
      }).join('');

      sessionList.innerHTML = sessionsHtml;

      // Attach event listeners
      sessionList.querySelectorAll('.load-session-trigger').forEach(trigger => {
          trigger.addEventListener('click', (e) => {
              e.stopPropagation();
              const sessionId = e.target.closest('.session-item').dataset.sessionId;
              loadSession(sessionId);
          });
      });

      sessionList.querySelectorAll('.delete-session').forEach(btn => {
          btn.addEventListener('click', (e) => {
              e.stopPropagation();
              const sessionId = e.target.closest('.session-item').dataset.sessionId;
              deleteSession(sessionId);
          });
      });
  }

  async function startNewSession() {
      if (!isMemoryEnabled) return;
      
      try {
          const response = await fetch('/api/agent/sessions/new', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' }
          });
          const data = await response.json();
          
          if (data.success) {
              currentSessionId = data.session_id;
              sessionStatus.textContent = `Session: ${data.session_id.slice(-8)}`;
              
              // Clear chat and show new session message
              chatBody.innerHTML = `
                  <div class="chat chat-start">
                      <div class="chat-bubble chat-bubble-success">
                          <div class="markdown-content">
                              <p>🆕 New session started! How can I help you with bioinformatics tools today?</p>
                          </div>
                      </div>
                  </div>
              `;
              
              await loadSessions();
              hideSidebar();
              saveState();
          }
      } catch (error) {
          console.error('Error starting new session:', error);
      }
  }

  async function loadSession(sessionId) {
      if (!isMemoryEnabled) return;
      
      try {
          const response = await fetch(`/api/agent/sessions/${sessionId}/load`, {
              method: 'POST'
          });
          const data = await response.json();
          
          if (data.success) {
              currentSessionId = sessionId;
              sessionStatus.textContent = `Session: ${sessionId.slice(-8)}`;
              
              // Load conversation history
              const historyResponse = await fetch('/api/agent/history');
              const historyData = await historyResponse.json();
              
              chatBody.innerHTML = '';
              if (historyData.history && historyData.history.length > 0) {
                  historyData.history.forEach(turn => {
                      addMessage(turn.content, turn.role);
                  });
              } else {
                  chatBody.innerHTML = `
                      <div class="chat chat-start">
                          <div class="chat-bubble chat-bubble-primary">
                              <div class="markdown-content">
                                  <p>📂 Session loaded! Continue our conversation.</p>
                              </div>
                          </div>
                      </div>
                  `;
              }
              
              await loadSessions();
              hideSidebar();
              saveState();
          }
      } catch (error) {
          console.error('Error loading session:', error);
      }
  }

  async function deleteSession(sessionId) {
      if (!isMemoryEnabled) return;
      
      if (confirm(`Delete session ${sessionId.slice(-8)}? This cannot be undone.`)) {
          try {
              const response = await fetch(`/api/agent/sessions/${sessionId}`, {
                  method: 'DELETE'
              });
              const data = await response.json();
              
              if (data.success) {
                  if (sessionId === currentSessionId) {
                      currentSessionId = null;
                      sessionStatus.textContent = 'No active session';
                      
                      // Clear chat and show session deleted message
                      chatBody.innerHTML = `
                          <div class="chat chat-start">
                              <div class="chat-bubble chat-bubble-warning">
                                  <div class="markdown-content">
                                      <p>🗑️ Session deleted. Start a new conversation!</p>
                                  </div>
                              </div>
                          </div>
                      `;
                      saveState();
                  }
                  await loadSessions();
              }
          } catch (error) {
              console.error('Error deleting session:', error);
          }
      }
  }

  async function saveCurrentSession() {
      if (!isMemoryEnabled) return;
      
      try {
          const response = await fetch('/api/agent/sessions/save', {
              method: 'POST'
          });
          const data = await response.json();
          
          if (data.success) {
              // Show brief success indicator
              const originalText = saveSessionBtn.innerHTML;
              saveSessionBtn.innerHTML = '<i class="ti ti-check"></i>';
              saveSessionBtn.classList.add('btn-success');
              
              setTimeout(() => {
                  saveSessionBtn.innerHTML = originalText;
                  saveSessionBtn.classList.remove('btn-success');
              }, 1500);
          }
      } catch (error) {
          console.error('Error saving session:', error);
      }
  }

  async function cleanupOldSessions() {
      if (!isMemoryEnabled) return;
      
      const days = prompt('Keep sessions from how many days ago? (default: 30)', '30');
      if (days === null) return;
      
      try {
          const response = await fetch('/api/agent/sessions/cleanup', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ daysToKeep: parseInt(days) || 30 })
          });
          const data = await response.json();
          
          if (data.success) {
              alert(`Cleaned up ${data.deleted_count} old sessions`);
              await loadSessions();
          }
      } catch (error) {
          console.error('Error cleaning up sessions:', error);
      }
  }

  // Enhanced clear history function
  function clearChatHistory() {
      if (isMemoryEnabled) {
          if (confirm('Clear current session history? This will clear the conversation but keep the session.')) {
              fetch('/api/agent/clear-history', { method: 'POST' })
                  .then(() => {
                      chatBody.innerHTML = `
                          <div class="chat chat-start">
                              <div class="chat-bubble chat-bubble-primary">
                                  <div class="markdown-content">
                                      <p>🧹 Session cleared! Ready for a fresh conversation.</p>
                                  </div>
                              </div>
                          </div>
                      `;
                      saveState();
                  })
                  .catch(error => console.error('Error clearing history:', error));
          }
      } else {
          // Basic mode - just clear locally
          chatBody.innerHTML = `
              <div class="chat chat-start">
                  <div class="chat-bubble chat-bubble-primary">
                      <div class="markdown-content"><p>Hello! How can I help you with bioinformatics tools today?</p></div>
                  </div>
              </div>
          `;
          saveState();
      }
  }

  // Check markdown library availability (simple like test-marked.html)
  function checkMarkdownSupport() {
    if (typeof marked !== 'undefined' && marked.parse) {
      console.log('✅ Marked.js library loaded successfully');
      if (typeof hljs !== 'undefined') {
        console.log('✅ Highlight.js loaded - syntax highlighting enabled');
      }
      return true;
    } else {
      console.error('❌ Marked.js library not available');
      return false;
    }
  }



  // Debug function to compare original vs rendered text
  window.debugMarkdown = function(originalText, renderedHtml) {
    console.group('🔍 Markdown Debug');
    console.log('📝 Original text:', originalText);
    console.log('🎨 Rendered HTML:', renderedHtml);
    console.log('📏 Original length:', originalText.length);
    console.log('📏 Rendered length:', renderedHtml.length);
    
    // Check for common markdown patterns
    const hasHeaders = /^#+\s/.test(originalText);
    const hasBold = /\*\*.*?\*\*/.test(originalText);
    const hasCode = /`.*?`/.test(originalText);
    const hasCodeBlocks = /```/.test(originalText);
    
    console.log('🔍 Contains headers:', hasHeaders);
    console.log('🔍 Contains bold:', hasBold);
    console.log('🔍 Contains inline code:', hasCode);
    console.log('🔍 Contains code blocks:', hasCodeBlocks);
    console.groupEnd();
  };

  

  // Handle window resize to keep popup within bounds
  window.addEventListener('resize', () => {
    if (!agentChatPopup.classList.contains('hidden')) {
      constrainToViewport();
    }
  });

  // Initial status check and state load (simple like test-marked.html)
  document.addEventListener('DOMContentLoaded', () => {
    // Simple initialization like test-marked.html
    setTimeout(() => {
      initializeMarked();
      checkMarkdownSupport();
    loadState();
    checkAgentStatusLoop();
    loadStoredVizFile();
    }, 100);
  });
  
  // Handle workflow building from Agent
  function handleWorkflowBuild(workflowData) {
    try {
      console.log('Building workflow from Agent:', workflowData);
      
      // Check if we're on the workflow page
      if (typeof window.workflowBuilder === 'undefined') {
        // Not on workflow page, redirect there
        const workflowUrl = '/workflow';
        
        // Store workflow data in sessionStorage for building after redirect
        sessionStorage.setItem('pendingWorkflow', JSON.stringify(workflowData));
        
        // Show notification and redirect automatically
        console.log('🤖 Redirecting to workflow page to build workflow...');
        
        // Show a brief notification before redirect
        const notification = document.createElement('div');
        notification.className = 'alert alert-info fixed top-20 right-4 z-50 w-96';
        notification.innerHTML = `
          <div class="flex items-center">
            <i class="ti ti-robot mr-2"></i>
            <div>
              <div class="font-semibold">Building Workflow...</div>
              <div class="text-sm opacity-90">Redirecting to workflow page to build your SPAdes + QUAST pipeline.</div>
            </div>
          </div>
        `;
        document.body.appendChild(notification);
        
        // Redirect after a short delay
        setTimeout(() => {
          window.location.href = workflowUrl;
        }, 1500);
        return;
      }
      
      // We're on the workflow page, build directly
      buildWorkflowOnCanvas(workflowData);
      
    } catch (error) {
      console.error('Error handling workflow build:', error);
      alert('Error building workflow: ' + error.message);
    }
  }
  
  function buildWorkflowOnCanvas(workflowData) {
    try {
      // Clear existing workflow
      if (window.workflowBuilder) {
        window.workflowBuilder.clearCanvas();
        
        // Add nodes and create ID mapping
        const nodeIdMapping = new Map(); // Maps Agent IDs to actual node IDs
        
        workflowData.nodes.forEach(nodeData => {
          try {
            const node = window.workflowBuilder.createNode(
              nodeData.type,
              nodeData.component,
              nodeData.x,
              nodeData.y
            );
            
            // Check if node was created successfully
            if (!node || !node.id) {
              console.error('Failed to create node:', nodeData);
              return;
            }
            
            // Map Agent ID to actual node ID
            nodeIdMapping.set(nodeData.id, node.id);
            console.log(`📍 Node ID mapping (widget): ${nodeData.id} → ${node.id}`);
            
            // Configure node parameters
            if (nodeData.config && Object.keys(nodeData.config).length > 0) {
              const nodeElement = document.getElementById(node.id);
              if (nodeElement) {
                // Store config in node data
                const nodeMapEntry = window.workflowBuilder.nodes.get(node.id);
                if (nodeMapEntry) {
                  nodeMapEntry.config = nodeData.config;
                }
                
                // Update node display to show it's configured
                const configBtn = nodeElement.querySelector('.config-btn');
                if (configBtn) {
                  configBtn.classList.remove('btn-outline');
                  configBtn.classList.add('btn-primary');
                  configBtn.innerHTML = '<i class="ti ti-settings-filled mr-1"></i>Configured';
                }
              }
            }
          } catch (error) {
            console.error('Error creating node:', nodeData, error);
          }
        });
        
        // Add connections after delay to ensure nodes are fully initialized
        setTimeout(() => {
          console.log('🔗 Creating connections from Agent (widget):', workflowData.connections);
          
          if (!workflowData.connections || workflowData.connections.length === 0) {
            console.warn('⚠️ No connections found in Agent workflow data (widget)');
            return;
          }
          
          workflowData.connections.forEach((connData, index) => {
            try {
              console.log(`🔗 Creating connection ${index + 1} (widget):`, connData);
              
              // Map Agent IDs to actual node IDs
              const actualFromNodeId = nodeIdMapping.get(connData.fromNode);
              const actualToNodeId = nodeIdMapping.get(connData.toNode);
              
              if (!actualFromNodeId) {
                console.error(`❌ From node ID mapping not found: ${connData.fromNode}`);
                return;
              }
              
              if (!actualToNodeId) {
                console.error(`❌ To node ID mapping not found: ${connData.toNode}`);
                return;
              }
              
              console.log(`🔄 ID mapping (widget): ${connData.fromNode} → ${actualFromNodeId}, ${connData.toNode} → ${actualToNodeId}`);
              
              // Verify nodes exist in DOM
              const fromNodeElement = document.getElementById(actualFromNodeId);
              const toNodeElement = document.getElementById(actualToNodeId);
              
              if (!fromNodeElement) {
                console.error(`❌ From node not found in DOM: ${actualFromNodeId}`);
                return;
              }
              
              if (!toNodeElement) {
                console.error(`❌ To node not found in DOM: ${actualToNodeId}`);
                return;
              }
              
              console.log(`✅ Nodes verified (widget) - From: ${actualFromNodeId}, To: ${actualToNodeId}`);
              
              const result = window.workflowBuilder.createConnection(
                actualFromNodeId,
                connData.fromPort,
                actualToNodeId,
                connData.toPort
              );
              
              console.log(`✅ Connection ${index + 1} created successfully (widget):`, result);
              
            } catch (error) {
              console.error(`❌ Error creating connection ${index + 1} (widget):`, connData, error);
            }
          });
          
          // Update canvas placeholder
          window.workflowBuilder.updateCanvasPlaceholder();
          
          console.log('✅ Workflow built successfully on canvas');
          
          // Show success message
          const successMsg = document.createElement('div');
          successMsg.className = 'alert alert-success fixed top-20 right-4 z-50 w-96';
          successMsg.innerHTML = `
            <div class="flex items-center">
              <i class="ti ti-check-circle mr-2"></i>
              <div>
                <div class="font-semibold">Workflow Built Successfully!</div>
                <div class="text-sm opacity-90">The Agent has created your workflow on the canvas.</div>
              </div>
            </div>
          `;
          document.body.appendChild(successMsg);
          
          // Auto-remove success message
          setTimeout(() => {
            if (successMsg.parentNode) {
              successMsg.remove();
            }
          }, 5000);
          
        }, 1000); // Increased delay to ensure nodes are fully initialized
      }
    } catch (error) {
      console.error('Error building workflow on canvas:', error);
      alert('Error building workflow: ' + error.message);
    }
  }
  
  // Check for pending workflow on page load (for redirected builds)
  function checkPendingWorkflow() {
    const pendingWorkflow = sessionStorage.getItem('pendingWorkflow');
    if (pendingWorkflow && typeof window.workflowBuilder !== 'undefined') {
      try {
        const workflowData = JSON.parse(pendingWorkflow);
        sessionStorage.removeItem('pendingWorkflow');
        
        // Small delay to ensure workflow builder is fully initialized
        setTimeout(() => {
          buildWorkflowOnCanvas(workflowData);
        }, 500);
        
      } catch (error) {
        console.error('Error loading pending workflow:', error);
        sessionStorage.removeItem('pendingWorkflow');
      }
    }
  }
  
  // Call checkPendingWorkflow when on workflow page
  if (typeof window.workflowBuilder !== 'undefined') {
    document.addEventListener('DOMContentLoaded', checkPendingWorkflow);
  }
</script>

<!-- Load highlight.js first, then marked.js (using different CDN) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<script>
// Initialize marked.js (exactly like test-marked.html)
function initializeMarked() {
    if (typeof marked === 'undefined') {
        console.error('Marked.js not available');
        return false;
    }
    
    // Configure marked.js with highlight.js (back to simple version)
    marked.setOptions({
        highlight: function(code, lang) {
            if (typeof hljs !== 'undefined' && lang && hljs.getLanguage(lang)) {
                try {
                    return hljs.highlight(code, { language: lang, ignoreIllegals: true }).value;
                } catch (error) {
                    console.warn('Highlight.js error for language', lang, ':', error);
                }
            }
            return code;
        },
        breaks: true,
        gfm: true,
        tables: true,
        sanitize: false,
        smartLists: true,
        smartypants: true
    });
    
    console.log('✅ Marked.js configured successfully');
    return true;
}

  // Add copy buttons to code blocks after markdown rendering
  function addCopyButtonsToCodeBlocks(container) {
    const codeBlocks = container.querySelectorAll('pre code');
    codeBlocks.forEach(codeElement => {
      const preElement = codeElement.parentElement;
      if (preElement && !preElement.querySelector('.copy-code-btn')) {
        // Generate unique ID for this code block
        const codeId = 'code-' + Math.random().toString(36).substr(2, 9);
        codeElement.id = codeId;
        
        // Get language from class name
        let lang = 'text';
        const langMatch = codeElement.className.match(/language-(\S+)/);
        if (langMatch) {
          lang = langMatch[1];
        }
        
        // Create code block container
        const container = document.createElement('div');
        container.className = 'code-block-container relative';
        
        // Create header with copy button
        const header = document.createElement('div');
        header.className = 'code-header flex justify-between items-center text-xs text-gray-400 px-3 py-2 bg-gray-800 rounded-t-lg';
        header.innerHTML = `
          <span>${lang}</span>
          <button class="copy-code-btn btn btn-xs btn-ghost" data-code-id="${codeId}" title="Copy code">
            <i class="ti ti-copy"></i>
          </button>
        `;
        
        // Wrap the pre element
        preElement.parentElement.insertBefore(container, preElement);
        container.appendChild(header);
        container.appendChild(preElement);
        
        // Update pre element styles
        preElement.style.margin = '0';
        preElement.style.borderRadius = '0 0 0.5rem 0.5rem';
      }
    });
  }

  // Copy functionality
  function copyToClipboard(text) {
    if (navigator.clipboard && window.isSecureContext) {
      return navigator.clipboard.writeText(text);
    } else {
      // Fallback for older browsers
      const textArea = document.createElement('textarea');
      textArea.value = text;
      textArea.style.position = 'absolute';
      textArea.style.left = '-999999px';
      document.body.prepend(textArea);
      textArea.select();
      try {
        document.execCommand('copy');
      } catch (error) {
        console.error('Copy failed:', error);
      } finally {
        textArea.remove();
      }
    }
  }

  // Event delegation for copy buttons
  document.addEventListener('click', (e) => {
    // Copy code button
    if (e.target.closest('.copy-code-btn')) {
      const btn = e.target.closest('.copy-code-btn');
      const codeId = btn.getAttribute('data-code-id');
      const codeElement = document.getElementById(codeId);
      if (codeElement) {
        const code = codeElement.textContent || codeElement.innerText;
        copyToClipboard(code).then(() => {
          // Visual feedback
          const originalIcon = btn.innerHTML;
          btn.innerHTML = '<i class="ti ti-check"></i>';
          btn.classList.add('btn-success');
          setTimeout(() => {
            btn.innerHTML = originalIcon;
            btn.classList.remove('btn-success');
          }, 2000);
        }).catch(err => {
          console.error('Failed to copy code:', err);
        });
      }
    }
    
    // Copy full answer button
    if (e.target.closest('.copy-answer-btn')) {
      const btn = e.target.closest('.copy-answer-btn');
      const chatBubble = btn.closest('.chat-bubble');
      if (chatBubble) {
        const markdownContent = chatBubble.querySelector('.markdown-content');
        const text = markdownContent ? markdownContent.textContent || markdownContent.innerText : chatBubble.textContent || chatBubble.innerText;
        copyToClipboard(text).then(() => {
          // Visual feedback
          const originalIcon = btn.innerHTML;
          btn.innerHTML = '<i class="ti ti-check"></i>';
          btn.classList.add('btn-success');
          setTimeout(() => {
            btn.innerHTML = originalIcon;
            btn.classList.remove('btn-success');
          }, 2000);
        }).catch(err => {
          console.error('Failed to copy answer:', err);
        });
      }
    }
    
    // Edit and resend button
    if (e.target.closest('.edit-resend-btn')) {
      const btn = e.target.closest('.edit-resend-btn');
      const userBubble = btn.closest('.chat-bubble');
      if (userBubble) {
        const originalText = userBubble.textContent || userBubble.innerText;
        chatInput.value = originalText.trim();
        chatInput.focus();
        chatInput.select();
      }
    }
  });

  // === File selection for viz ===
  const selectedVizFileEl = document.getElementById('selected-viz-file');
  const selectFileBtn = document.getElementById('select-file-btn');
  const setFileBtn = document.getElementById('set-file-btn');
  const filePickerModal = document.getElementById('file-picker-modal');
  const filePickerFrame = document.getElementById('file-picker-frame');
  const closePickerBtn = document.getElementById('close-picker-btn');
  const vizGenerateBtn = document.getElementById('viz-generate-btn');
  const vizLibSelect = document.getElementById('viz-lib-select');

  function loadStoredVizFile() {
    const stored = localStorage.getItem('selectedVizFile');
    if (stored) {
      selectedVizFile = stored;
      updateVizFileDisplay();
    }
  }

  function updateVizFileDisplay() {
    if (selectedVizFile) {
      selectedVizFileEl.textContent = selectedVizFile;
      selectedVizFileEl.title = selectedVizFile;
    } else {
      selectedVizFileEl.textContent = 'None';
      selectedVizFileEl.title = '';
    }
  }

  selectFileBtn.addEventListener('click', () => {
    // Open embedded file picker
    if (filePickerFrame) {
      filePickerFrame.src = '/picker/file-picker?dir=/&type=input&picker=1';
    }
    if (filePickerModal) {
      filePickerModal.showModal();
    }
  });

  setFileBtn.addEventListener('click', () => {
    const val = prompt('Please enter/paste the remote data file path (e.g., /home/xxx/data.csv):', selectedVizFile);
    if (val && val.trim()) {
      selectedVizFile = val.trim();
      localStorage.setItem('selectedVizFile', selectedVizFile);
      updateVizFileDisplay();
    }
  });

  if (vizGenerateBtn) {
    vizGenerateBtn.addEventListener('click', async () => {
      const prompt = chatInput.value.trim();
      if (!prompt) {
        alert('Please enter a visualization request before generating code');
        return;
      }
      // Echo user intent to chat for context
      addMessage(prompt, 'user');
      chatInput.value = '';
      vizGenerateBtn.disabled = true;
      vizGenerateBtn.classList.add('loading');
      try {
        const resp = await fetch('/api/viz/codegen', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            prompt,
            file_path: selectedVizFile || undefined,
            viz_lib: vizLibSelect ? vizLibSelect.value : undefined
          })
        });
        const data = await resp.json();
        if (!data.success) {
          throw new Error(data.error || 'Code generation failed');
        }
        lastVizCode = data.code || '';
        if (lastVizCode) {
          renderVizCodeCard(lastVizCode);
        } else {
          alert('Generated successfully but code is empty');
        }
      } catch (err) {
        console.error('viz codegen error', err);
        alert(`Code generation failed: ${err.message}`);
      } finally {
        vizGenerateBtn.disabled = false;
        vizGenerateBtn.classList.remove('loading');
      }
    });
  }

  if (closePickerBtn && filePickerModal) {
    closePickerBtn.addEventListener('click', () => {
      filePickerModal.close();
    });
  }

  // Listen for file selection event from iframe
  window.addEventListener('message', (event) => {
    if (event.data && event.data.type === 'file-selected') {
      const picked = event.data.path || (event.data.paths && event.data.paths[0]);
      if (picked) {
        selectedVizFile = picked;
        localStorage.setItem('selectedVizFile', selectedVizFile);
        updateVizFileDisplay();
      }
      if (filePickerModal) filePickerModal.close();
    }
  });

  // === Visualization helpers ===
  function renderVizCodeCard(code) {
    const card = document.createElement('div');
    card.className = 'mt-3 border border-base-300 rounded-lg p-3 bg-base-200';
    card.innerHTML = `
      <div class="flex items-center justify-between mb-2">
    <div class="font-semibold">Seaborn Code Preview</div>
        <div class="flex gap-2">
          <button class="btn btn-xs btn-primary" data-action="viz-run">Run</button>
          <button class="btn btn-xs btn-ghost" data-action="viz-regen">Regenerate</button>
        </div>
      </div>
      <pre class="overflow-auto text-xs bg-base-100 p-2 rounded code-block"><code>${escapeHtml(code)}</code></pre>
      <div class="viz-status text-sm mt-2 opacity-70">Not run yet</div>
      <div class="viz-image mt-2"></div>
    `;
    chatBody.appendChild(card);
    chatBody.scrollTop = chatBody.scrollHeight;

    card.querySelector('[data-action="viz-run"]').addEventListener('click', async () => {
      await runVizCode(card, code);
    });
    card.querySelector('[data-action="viz-regen"]').addEventListener('click', async () => {
      await regenerateVizCode(card);
    });
  }

  async function runVizCode(card, code) {
    const statusEl = card.querySelector('.viz-status');
    const imgEl = card.querySelector('.viz-image');
    statusEl.textContent = 'Running...';
    imgEl.innerHTML = '';
    try {
      const selectedLib = vizLibSelect ? vizLibSelect.value : 'seaborn';
      const desiredFormat = selectedLib === 'bokeh' ? 'html' : 'png';
      const resp = await fetch('/api/viz/run', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code, format: desiredFormat })
      });
      const data = await resp.json();
      if (!data.success) {
        throw new Error(data.error || 'Run failed');
      }
      statusEl.textContent = 'Completed';
      imgEl.innerHTML = '';
      if (data.format === 'html' && data.htmlContent) {
        const iframe = document.createElement('iframe');
        iframe.className = 'w-full h-96 border border-base-300 rounded';
        iframe.srcdoc = data.htmlContent;
        imgEl.appendChild(iframe);
      } else {
        const img = document.createElement('img');
        img.src = `data:image/${data.format || 'png'};base64,${data.imageBase64}`;
        img.alt = 'viz output';
        img.className = 'max-w-full border border-base-300 rounded';
        imgEl.appendChild(img);
      }
    } catch (err) {
      statusEl.textContent = `Run failed: ${err.message}`;
    }
  }

  async function regenerateVizCode(card) {
    const statusEl = card.querySelector('.viz-status');
    statusEl.textContent = 'Regenerating...';
    try {
      const resp = await fetch('/api/viz/codegen', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          prompt: 'Regenerate seaborn code with same intent but improved defaults.',
          previous_code: lastVizCode || undefined,
          file_path: selectedVizFile || undefined
        })
      });
      const data = await resp.json();
      if (!data.success) {
        throw new Error(data.error || 'Generation failed');
      }
      lastVizCode = data.code || '';
      const codeEl = card.querySelector('code');
      codeEl.textContent = data.code;
      statusEl.textContent = 'Regenerated, click run';
    } catch (err) {
      statusEl.textContent = `Regeneration failed: ${err.message}`;
    }
  }

  function escapeHtml(str) {
    return str.replace(/[&<>"']/g, function(m) {
      return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[m];
    });
  }

  // Simple test function (like test-marked.html)
  window.testMarkdown = function(text) {
    try {
      const result = marked.parse(text);
      console.log('Test result:', result);
      return result;
    } catch (error) {
      console.error('Test failed:', error);
      return `<p>Error: ${error.message}</p>`;
    }
  };
</script>

