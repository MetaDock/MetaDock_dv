<style>
/* Comprehensive Markdown Styling for Chat Bubbles */

/* ===== TEXT FORMATTING ===== */
.chat-bubble strong, 
.chat-bubble b,
.markdown-content strong,
.markdown-content b {
  font-weight: 700;
  color: inherit;
}

.chat-bubble em,
.chat-bubble i,
.markdown-content em,
