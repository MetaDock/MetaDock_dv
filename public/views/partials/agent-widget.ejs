<!-- Agent Widget with Memory -->
<div id="agent-widget-container" class="fixed bottom-5 right-5 z-50">
  <!-- FAB Button -->
  <button id="agent-fab" class="btn btn-primary btn-circle btn-lg shadow-lg" onclick="toggleAgentChat()">
    <i id="agent-icon" class="ti ti-message-chatbot text-3xl"></i>
  </button>

  <!-- Chat Popup -->
  <div id="agent-chat-popup" class="hidden fixed bg-base-100 rounded-lg shadow-2xl border border-base-300 flex flex-col" style="width: 24rem; height: 32rem; bottom: 5.5rem; right: 1.25rem;">
    <!-- Header -->
    <div id="chat-header" class="card-title bg-base-200 p-4 flex items-center justify-between cursor-move">
      <h2 class="text-lg font-bold flex items-center">
        <i class="ti ti-message-chatbot mr-2"></i> Bioinfo Agent
        <span id="session-indicator" class="badge badge-success badge-sm ml-2 hidden">Memory</span>
      </h2>
      <div class="flex items-center gap-1">
        <button id="session-menu-btn" class="btn btn-sm btn-ghost btn-circle" title="Session Management">
            <i class="ti ti-history"></i>
        </button>
        <button id="clear-chat-btn" class="btn btn-sm btn-ghost btn-circle" title="Clear chat history">
            <i class="ti ti-trash"></i>
        </button>
        <button class="btn btn-sm btn-ghost btn-circle" onclick="toggleAgentChat()">
            <i class="ti ti-x"></i>
        </button>
      </div>
    </div>

    <!-- Session Sidebar (側拉) -->
    <div id="session-sidebar" class="fixed left-0 top-0 h-full w-80 bg-base-100 shadow-2xl border-r border-base-300 transform -translate-x-full transition-transform duration-300 ease-in-out z-50 hidden">
      <div class="flex flex-col h-full">
        <!-- Sidebar Header -->
        <div class="flex items-center justify-between p-4 border-b border-base-300">
          <h2 class="font-bold text-lg">Chat History</h2>
          <button id="close-session-sidebar" class="btn btn-sm btn-ghost btn-circle">
            <i class="ti ti-x"></i>
          </button>
        </div>
        
        <!-- New Chat Button -->
        <div class="p-4 border-b border-base-300">
          <button id="new-session-btn" class="btn btn-primary w-full">
            <i class="ti ti-plus mr-2"></i> New Chat
          </button>
        </div>

        <!-- Session List -->
        <div class="flex-1 overflow-y-auto p-4">
          <div id="session-list">
            <div class="text-center py-8 opacity-60">
              <i class="ti ti-message-circle text-4xl mb-2"></i>
              <p class="text-sm">Loading chat history...</p>
            </div>
          </div>
        </div>

        <!-- Sidebar Footer -->
        <div class="p-4 border-t border-base-300">
          <div class="flex gap-2">
            <button id="save-session-btn" class="btn btn-sm btn-success flex-1">
              <i class="ti ti-device-floppy mr-1"></i> Save
            </button>
            <button id="cleanup-sessions-btn" class="btn btn-sm btn-warning flex-1">
              <i class="ti ti-trash mr-1"></i> Cleanup
            </button>
          </div>
          <div class="mt-2 text-xs opacity-60 text-center" id="session-status">
            No active session
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar Overlay -->
    <div id="sidebar-overlay" class="fixed inset-0 bg-black bg-opacity-50 z-40 hidden" onclick="hideSidebar()"></div>

    <!-- Chat Body -->
    <div id="chat-body" class="card-body flex-grow p-4 overflow-y-auto bg-base-100" style="flex: 1 1 auto;">
      <!-- Messages will be appended here -->
      <div class="chat chat-start">
        <div class="chat-bubble chat-bubble-primary">
          <div class="markdown-content">
            <p>Hello! How can I help you with bioinformatics tools today?</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Input Area -->
    <div class="card-footer bg-base-200 p-4 border-t border-base-300">
      <div class="flex items-center space-x-2">
        <input type="text" id="chat-input" class="input input-bordered w-full" placeholder="Ask a question..." autocomplete="off">
        <button id="chat-send-btn" class="btn btn-primary btn-circle">
          <i class="ti ti-send"></i>
        </button>
        <!-- Stop Generation Button (hidden by default) -->
        <button id="stop-generation-btn" class="btn btn-error btn-circle hidden" title="Stop generation">
          <i class="ti ti-square"></i>
        </button>
      </div>
    </div>
    <!-- Resize Handles -->
    <div class="resize-handle n"></div><div class="resize-handle s"></div>
    <div class="resize-handle e"></div><div class="resize-handle w"></div>
    <div class="resize-handle nw"></div><div class="resize-handle ne"></div>
    <div class="resize-handle sw"></div><div class="resize-handle se"></div>
  </div>
</div>

<script>
  const agentFab = document.getElementById('agent-fab');
  const agentChatPopup = document.getElementById('agent-chat-popup');
  const agentIcon = document.getElementById('agent-icon');
  const chatHeader = document.getElementById('chat-header');
  const clearChatBtn = document.getElementById('clear-chat-btn');
  const chatBody = document.getElementById('chat-body');
  const chatInput = document.getElementById('chat-input');
  const chatSendBtn = document.getElementById('chat-send-btn');
  const stopGenerationBtn = document.getElementById('stop-generation-btn');
  
  // AbortController for stopping generation
  let currentAbortController = null;
  
  // Memory-related elements
  const sessionMenuBtn = document.getElementById('session-menu-btn');
  const sessionSidebar = document.getElementById('session-sidebar');
  const closeSessionSidebar = document.getElementById('close-session-sidebar');
  const sidebarOverlay = document.getElementById('sidebar-overlay');
  const sessionIndicator = document.getElementById('session-indicator');
  const sessionStatus = document.getElementById('session-status');
  const sessionList = document.getElementById('session-list');
  const newSessionBtn = document.getElementById('new-session-btn');
  const saveSessionBtn = document.getElementById('save-session-btn');
  const cleanupSessionsBtn = document.getElementById('cleanup-sessions-btn');
  
  // Memory state
  let currentSessionId = null;
  let sessions = [];
  let isMemoryEnabled = false;





  function toggleAgentChat() {
    agentChatPopup.classList.toggle('hidden');
    if (agentChatPopup.classList.contains('hidden')) {
      agentIcon.classList.remove('ti-x');
      agentIcon.classList.add('ti-message-chatbot');
    } else {
      agentIcon.classList.remove('ti-message-chatbot');
      agentIcon.classList.add('ti-x');
    }
    saveState();
  }

  // --- Dragging & Resizing Logic ---
  let isDragging = false;
  let isResizing = false;
  let resizeDirection = '';
  let offsetX, offsetY, lastX, lastY;

  chatHeader.addEventListener('mousedown', (e) => {
    // Prevent starting a drag on the close button
    if (e.target.closest('button')) return;
    isDragging = true;
    offsetX = e.clientX - agentChatPopup.offsetLeft;
    offsetY = e.clientY - agentChatPopup.offsetTop;
    agentChatPopup.style.userSelect = 'none';
  });

  agentChatPopup.querySelectorAll('.resize-handle').forEach(handle => {
    handle.addEventListener('mousedown', (e) => {
        isResizing = true;
        resizeDirection = e.target.className.split(' ')[1];
        lastX = e.clientX;
        lastY = e.clientY;
        document.body.style.cursor = getComputedStyle(e.target).cursor;
        agentChatPopup.style.userSelect = 'none';
        e.stopPropagation();
        e.preventDefault();
    });
  });

  document.addEventListener('mousemove', (e) => {
    if (isDragging) {
        e.preventDefault();
        agentChatPopup.style.left = `${e.clientX - offsetX}px`;
        agentChatPopup.style.top = `${e.clientY - offsetY}px`;
        agentChatPopup.style.bottom = 'auto';
        agentChatPopup.style.right = 'auto';
    } else if (isResizing) {
        e.preventDefault();
        
        const rect = agentChatPopup.getBoundingClientRect();
        let newWidth = rect.width;
        let newHeight = rect.height;
        let newLeft = rect.left;
        let newTop = rect.top;
        
        const deltaX = e.clientX - lastX;
        const deltaY = e.clientY - lastY;

        if (resizeDirection.includes('e')) newWidth += deltaX;
        if (resizeDirection.includes('w')) {
            newWidth -= deltaX;
            newLeft += deltaX;
        }
        if (resizeDirection.includes('s')) newHeight += deltaY;
        if (resizeDirection.includes('n')) {
            newHeight -= deltaY;
            newTop += deltaY;
        }

        // Apply minimum size constraints and update style
        if (newWidth >= 300) {
            agentChatPopup.style.width = `${newWidth}px`;
            if (resizeDirection.includes('w')) agentChatPopup.style.left = `${newLeft}px`;
        }
        if (newHeight >= 200) {
            agentChatPopup.style.height = `${newHeight}px`;
            if (resizeDirection.includes('n')) agentChatPopup.style.top = `${newTop}px`;
        }
        
        lastX = e.clientX;
        lastY = e.clientY;
    }
  });

  document.addEventListener('mouseup', () => {
    if (isDragging || isResizing) {
      isDragging = false;
      isResizing = false;
      resizeDirection = '';
      agentChatPopup.style.userSelect = 'auto';
      document.body.style.cursor = 'auto';
      saveState();
    }
  });
  
  function addMessage(message, sender) {
      const chatClass = sender === 'user' ? 'chat-end' : 'chat-start';
      const bubbleClass = sender === 'user' ? 'chat-bubble-secondary' : 'chat-bubble-primary';
      
      const messageElement = document.createElement('div');
      messageElement.className = `chat ${chatClass}`;
      
      const bubble = document.createElement('div');
      bubble.className = `chat-bubble ${bubbleClass}`;
      
      // Create markdown container for proper styling
      const markdownContainer = document.createElement('div');
      markdownContainer.className = 'markdown-content';
      
      // Parse markdown using marked.js (simple like test-marked.html)
      try {
          if (typeof marked !== 'undefined' && marked.parse) {
              const rendered = marked.parse(message);
              markdownContainer.innerHTML = rendered;
              
              // Add copy buttons to code blocks after rendering
              addCopyButtonsToCodeBlocks(markdownContainer);
          } else {
              console.error('Marked.js library not available!');
              markdownContainer.innerHTML = message;
          }
      } catch (error) {
          console.error('Error parsing markdown:', error);
          markdownContainer.innerHTML = message;
      }
      
      bubble.appendChild(markdownContainer);
      
      // Add action buttons
      const buttonContainer = document.createElement('div');
      buttonContainer.className = 'message-buttons flex items-center space-x-1 mt-2 opacity-0 group-hover:opacity-100 transition-opacity';
      
      if (sender === 'user') {
          // Edit and resend button for user messages
          const editBtn = document.createElement('button');
          editBtn.className = 'edit-resend-btn btn btn-xs btn-ghost';
          editBtn.title = 'Edit and resend';
          editBtn.innerHTML = '<i class="ti ti-edit"></i>';
          buttonContainer.appendChild(editBtn);
      } else {
          // Copy answer button for agent messages
          const copyBtn = document.createElement('button');
          copyBtn.className = 'copy-answer-btn btn btn-xs btn-ghost';
          copyBtn.title = 'Copy answer';
          copyBtn.innerHTML = '<i class="ti ti-copy"></i>';
          buttonContainer.appendChild(copyBtn);
      }
      
      bubble.appendChild(buttonContainer);
      messageElement.classList.add('group'); // For hover effects
      messageElement.appendChild(bubble);
      chatBody.appendChild(messageElement);
      chatBody.scrollTop = chatBody.scrollHeight;
  }

  function setAgentStatus(ready) {
      if (ready) {
          chatInput.disabled = false;
          chatSendBtn.disabled = false;
          chatInput.placeholder = "Ask a question...";
      } else {
          chatInput.disabled = true;
          chatSendBtn.disabled = true;
          chatInput.placeholder = "Initializing agent...";
      }
  }

  async function checkAgentStatusLoop() {
      try {
          const response = await fetch('/api/agent/status');
          const data = await response.json();
          setAgentStatus(data.ready);
          
          if (data.ready) {
              // Check if memory features are available
              await checkMemoryFeatures();
          } else {
              setTimeout(checkAgentStatusLoop, 2500); // Poll again
          }
      } catch (e) {
          setAgentStatus(false);
          setTimeout(checkAgentStatusLoop, 2500); // Poll again on error
      }
  }

  async function checkMemoryFeatures() {
      try {
          // Try to access memory features
          const response = await fetch('/api/agent/sessions');
          if (response.ok) {
              isMemoryEnabled = true;
              sessionIndicator.classList.remove('hidden');
              await updateSessionInfo();
              await loadSessions();
          }
      } catch (e) {
          // Memory features not available, use basic mode
          isMemoryEnabled = false;
          sessionIndicator.classList.add('hidden');
      }
  }

  async function askAgent(question) {
    addMessage(question, 'user');
    chatInput.value = '';
    chatInput.disabled = true;
    chatSendBtn.disabled = true;
    
    // Create AbortController for this request
    currentAbortController = new AbortController();
    
    // Show stop button, hide send button
    chatSendBtn.classList.add('hidden');
    stopGenerationBtn.classList.remove('hidden');

    // If no current session and memory is enabled, start a new session
    if (isMemoryEnabled && !currentSessionId) {
      try {
        const response = await fetch('/api/agent/sessions/new', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await response.json();
        if (data.success) {
          currentSessionId = data.session_id;
          console.log('Started new session:', currentSessionId);
        }
      } catch (error) {
        console.error('Error starting new session:', error);
      }
    }

    // Create a new, empty message bubble for the agent's response
    const agentMessageElement = document.createElement('div');
    agentMessageElement.className = 'chat chat-start';
    const agentBubble = document.createElement('div');
    agentBubble.className = 'chat-bubble chat-bubble-primary';
    // Add a dedicated container for markdown content
    agentBubble.innerHTML = '<div class="markdown-content"><span class="blinking-cursor"></span></div>'; 
    agentMessageElement.appendChild(agentBubble);
    chatBody.appendChild(agentMessageElement);
    chatBody.scrollTop = chatBody.scrollHeight;

    let fullAnswer = '';
    let sources = [];

    try {
      const response = await fetch('/api/agent/ask', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ 
          question,
          sessionId: currentSessionId 
        }),
        signal: currentAbortController.signal
      });

      if (!response.ok) {
        const errorData = await response.json();
        throw new Error(errorData.error || 'Agent API error');
      }

      const reader = response.body.getReader();
      const decoder = new TextDecoder();
      let buffer = '';

      // Set up the content container
      const markdownContainer = agentBubble.querySelector('.markdown-content');
      markdownContainer.innerHTML = ''; // Remove blinking cursor

      while (true) {
        const { done, value } = await reader.read();
        if (done) {
          // Process any remaining buffer content
          if (buffer.trim()) {
            const lines = buffer.split('\n\n');
            for (const line of lines) {
              if (line.startsWith('data: ')) {
                const jsonStr = line.substring(6);
                try {
                  const event = JSON.parse(jsonStr);
                  if (event.type === 'chunk' && event.content) {
                    fullAnswer += event.content;
                  } else if (event.type === 'sources' && event.sources) {
                    sources = event.sources;
                  } else if (event.type === 'final_data') {
                    if (event.answer) fullAnswer = event.answer;
                    if (event.sources) sources = event.sources;
                  } else if (event.type === 'final') {
                    if (event.answer) fullAnswer = event.answer;
                    if (event.sources) sources = event.sources;
                  }
                } catch (e) {
                  console.warn('Failed to parse remaining buffer:', line, e);
                }
              }
            }
          }
          break;
        }

        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n\n');
        buffer = lines.pop(); // Keep the last, potentially incomplete line

        for (const line of lines) {
          if (line.startsWith('data: ')) {
            const jsonStr = line.substring(6);
            try {
                const event = JSON.parse(jsonStr);

                if (event.type === 'chunk' && event.content) {
                    fullAnswer += event.content;
                    
                    try {
                        if (typeof marked !== 'undefined' && marked.parse) {
                            const rendered = marked.parse(fullAnswer);
                            markdownContainer.innerHTML = rendered + '<span class="blinking-cursor"></span>';
                            
                            // Add copy buttons to code blocks during streaming
                            addCopyButtonsToCodeBlocks(markdownContainer);
                        } else {
                            markdownContainer.innerHTML = fullAnswer + '<span class="blinking-cursor"></span>';
                        }
                    } catch (error) {
                        console.error('Error during streaming markdown:', error);
                        markdownContainer.innerHTML = fullAnswer + '<span class="blinking-cursor"></span>';
                    }
                    chatBody.scrollTop = chatBody.scrollHeight;
                } else if (event.type === 'sources' && event.sources) {
                    sources = event.sources;
                } else if (event.type === 'final_data') {
                    // In our new flow, final data is also handled via chunks and sources events
                    // But we can grab the final answer here if needed.
                    if (event.answer) fullAnswer = event.answer;
                    if (event.sources) sources = event.sources;
                } else if (event.type === 'final') {
                    // Handle final event type
                    if (event.answer) fullAnswer = event.answer;
                    if (event.sources) sources = event.sources;
                } else if (event.type === 'error') {
                    throw new Error(event.error);
                }
            } catch (e) {
                console.error('Failed to parse stream event:', jsonStr, e);
            }
          }
        }
      }

      // Final update to the bubble without the cursor (simple like test-marked.html)
      let finalMarkdown;
      try {
          if (typeof marked !== 'undefined' && marked.parse) {
              finalMarkdown = marked.parse(fullAnswer);
          } else {
              console.error('Marked.js not available');
              finalMarkdown = fullAnswer;
          }
      } catch (error) {
          console.error('Error parsing final markdown:', error);
          finalMarkdown = fullAnswer;
      }
      
      let sourcesHtmlContent = '';
      if (sources && sources.length > 0) {
        let sourcesHtml = '<hr class="my-2 border-base-300/50"><div class="text-xs mt-2 opacity-70"><strong>Sources:</strong><ul class="list-disc list-inside">';
        let hasValidSource = false;
        sources.forEach(source => {
            if (source && source.source) {
                sourcesHtml += `<li>${source.source}</li>`;
                hasValidSource = true;
            }
        });
        sourcesHtml += '</ul></div>';
        
        if (hasValidSource) {
            sourcesHtmlContent = sourcesHtml;
        }
      }
      markdownContainer.innerHTML = finalMarkdown + sourcesHtmlContent;
      
      // Add copy buttons to code blocks in final rendering
      addCopyButtonsToCodeBlocks(markdownContainer);
      
      chatBody.scrollTop = chatBody.scrollHeight;
      
      // Update session info if memory is enabled
      if (isMemoryEnabled) {
        updateSessionInfo();
      }
      
      saveState();

    } catch (error) {
      console.error('Error asking agent:', error);
      
      if (error.name === 'AbortError') {
        // Request was aborted by user
        agentBubble.classList.add('chat-bubble-warning');
        agentBubble.innerHTML = `Generation stopped by user.`;
      } else {
      agentBubble.classList.add('chat-bubble-error');
      agentBubble.innerHTML = `Sorry, I encountered an error: ${error.message}`;
      }
      saveState();
    } finally {
      chatInput.disabled = false;
      chatSendBtn.disabled = false;
      chatInput.focus();
      
      // Restore button states
      stopGenerationBtn.classList.add('hidden');
      chatSendBtn.classList.remove('hidden');
      
      // Clear AbortController
      currentAbortController = null;
    }
  }

  chatSendBtn.addEventListener('click', () => {
    const question = chatInput.value.trim();
    if (question) {
      askAgent(question);
    }
  });

  // Stop generation button event listener
  stopGenerationBtn.addEventListener('click', () => {
    if (currentAbortController) {
      currentAbortController.abort();
      console.log('Generation stopped by user');
    }
  });

  chatInput.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') {
      const question = chatInput.value.trim();
      if (question) {
        askAgent(question);
      }
    }
  });

  clearChatBtn.addEventListener('click', (e) => {
    e.stopPropagation(); // Prevent drag from starting
    clearChatHistory();
  });

  // Memory event listeners
  sessionMenuBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    showSidebar();
  });

  closeSessionSidebar.addEventListener('click', () => {
    hideSidebar();
  });

  newSessionBtn.addEventListener('click', () => {
    startNewSession();
  });

  saveSessionBtn.addEventListener('click', () => {
    saveCurrentSession();
  });

  cleanupSessionsBtn.addEventListener('click', () => {
    cleanupOldSessions();
  });



  // --- State Persistence ---
  function saveState() {
    const state = {
      history: chatBody.innerHTML,
      position: {
        left: agentChatPopup.style.left,
        top: agentChatPopup.style.top,
      },
      size: {
        width: agentChatPopup.style.width,
        height: agentChatPopup.style.height,
      },
      isOpen: !agentChatPopup.classList.contains('hidden'),
      memory: {
        enabled: isMemoryEnabled,
        currentSessionId: currentSessionId,
        sidebarOpen: !sessionSidebar.classList.contains('hidden')
      }
    };
    localStorage.setItem('agentWidgetState', JSON.stringify(state));
  }

  function loadState() {
    const savedState = localStorage.getItem('agentWidgetState');
    if (!savedState) return;

    const state = JSON.parse(savedState);
    
    if (state.history) {
      chatBody.innerHTML = state.history;
      chatBody.scrollTop = chatBody.scrollHeight;
    }

    if (state.position && state.position.left && state.position.top) {
      agentChatPopup.style.left = state.position.left;
      agentChatPopup.style.top = state.position.top;
      agentChatPopup.style.bottom = 'auto';
      agentChatPopup.style.right = 'auto';
    }

    if (state.size && state.size.width && state.size.height) {
      agentChatPopup.style.width = state.size.width;
      agentChatPopup.style.height = state.size.height;
    }

    if (state.isOpen) {
      agentChatPopup.classList.remove('hidden');
      agentIcon.classList.remove('ti-message-chatbot');
      agentIcon.classList.add('ti-x');
    } else {
      agentChatPopup.classList.add('hidden');
      agentIcon.classList.remove('ti-x');
      agentIcon.classList.add('ti-message-chatbot');
    }

    // Restore memory state
    if (state.memory) {
      if (state.memory.currentSessionId) {
        currentSessionId = state.memory.currentSessionId;
      }
      // Session panel state will be restored after memory features are checked
    }
  }

  // Memory Functions
  async function updateSessionInfo() {
      if (!isMemoryEnabled) return;
      
      try {
          const response = await fetch('http://127.0.0.1:5111/status');
          const data = await response.json();
          const sessionId = data.current_session_id;
          
          if (sessionId) {
              currentSessionId = sessionId;
              sessionStatus.textContent = `Session: ${sessionId.slice(-8)}`;
          } else {
              sessionStatus.textContent = 'No active session';
          }
      } catch (error) {
          console.error('Error getting session info:', error);
          sessionStatus.textContent = 'Session status unknown';
      }
  }

  function showSidebar() {
      if (!isMemoryEnabled) return;
      
      sessionSidebar.classList.remove('hidden');
      sidebarOverlay.classList.remove('hidden');
      // 触发动画
      setTimeout(() => {
          sessionSidebar.classList.remove('-translate-x-full');
      }, 10);
      loadSessions();
  }

  function hideSidebar() {
      sessionSidebar.classList.add('-translate-x-full');
      setTimeout(() => {
          sessionSidebar.classList.add('hidden');
          sidebarOverlay.classList.add('hidden');
      }, 300);
  }

  function getRelativeTime(dateString) {
      const now = new Date();
      const date = new Date(dateString);
      const diffMs = now - date;
      const diffMins = Math.floor(diffMs / 60000);
      const diffHours = Math.floor(diffMs / 3600000);
      const diffDays = Math.floor(diffMs / 86400000);

      if (diffMins < 1) return 'just now';
      if (diffMins < 60) return `${diffMins}m ago`;
      if (diffHours < 24) return `${diffHours}h ago`;
      if (diffDays < 7) return `${diffDays}d ago`;
      return date.toLocaleDateString();
  }

  async function loadSessions() {
      if (!isMemoryEnabled) return;
      
      try {
          sessionList.innerHTML = `
              <div class="text-center py-8 opacity-60">
                  <i class="ti ti-loading animate-spin text-2xl mb-2"></i>
                  <p class="text-sm">Loading chat history...</p>
              </div>
          `;
          
          const response = await fetch('/api/agent/sessions');
          const data = await response.json();
          sessions = data.sessions || [];
          
          renderSessions();
      } catch (error) {
          console.error('Error loading sessions:', error);
          sessionList.innerHTML = `
              <div class="text-center py-8 text-error">
                  <i class="ti ti-alert-circle text-2xl mb-2"></i>
                  <p class="text-sm">Error loading chat history</p>
              </div>
          `;
      }
  }

  function renderSessions() {
      if (sessions.length === 0) {
          sessionList.innerHTML = `
              <div class="text-center py-8 opacity-60">
                  <i class="ti ti-message-circle text-4xl mb-2"></i>
                  <p class="text-sm">No chat history yet</p>
                  <p class="text-xs">Start a conversation to see it here</p>
              </div>
          `;
          return;
      }

      const sessionsHtml = sessions.map(session => {
          const isActive = session.session_id === currentSessionId;
          const title = session.title || 'New Conversation';
          const createdDate = new Date(session.created_at).toLocaleDateString();
          const relativeTime = getRelativeTime(session.last_updated);
          
          return `
              <div class="session-item ${isActive ? 'bg-primary/10 border-primary' : 'hover:bg-base-200'} 
                   border rounded-lg p-3 mb-2 cursor-pointer transition-all duration-200" 
                   data-session-id="${session.session_id}">
                  <div class="flex items-start justify-between">
                      <div class="flex-1 min-w-0 ${!isActive ? 'load-session-trigger' : ''}" style="cursor: ${!isActive ? 'pointer' : 'default'}">
                          <div class="font-medium text-sm truncate mb-1" title="${title}">
                              ${isActive ? '<i class="ti ti-message-circle mr-1"></i>' : ''}${title}
                          </div>
                          <div class="text-xs opacity-60">${session.message_count} messages • ${relativeTime}</div>
                      </div>
                      <div class="flex gap-1 ml-2">
                          <button class="btn btn-xs btn-ghost btn-circle delete-session opacity-60 hover:opacity-100" title="Delete">
                              <i class="ti ti-trash text-xs"></i>
                          </button>
                      </div>
                  </div>
              </div>
          `;
      }).join('');

      sessionList.innerHTML = sessionsHtml;

      // Attach event listeners
      sessionList.querySelectorAll('.load-session-trigger').forEach(trigger => {
          trigger.addEventListener('click', (e) => {
              e.stopPropagation();
              const sessionId = e.target.closest('.session-item').dataset.sessionId;
              loadSession(sessionId);
          });
      });

      sessionList.querySelectorAll('.delete-session').forEach(btn => {
          btn.addEventListener('click', (e) => {
              e.stopPropagation();
              const sessionId = e.target.closest('.session-item').dataset.sessionId;
              deleteSession(sessionId);
          });
      });
  }

  async function startNewSession() {
      if (!isMemoryEnabled) return;
      
      try {
          const response = await fetch('/api/agent/sessions/new', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' }
          });
          const data = await response.json();
          
          if (data.success) {
              currentSessionId = data.session_id;
              sessionStatus.textContent = `Session: ${data.session_id.slice(-8)}`;
              
              // Clear chat and show new session message
              chatBody.innerHTML = `
                  <div class="chat chat-start">
                      <div class="chat-bubble chat-bubble-success">
                          <div class="markdown-content">
                              <p>🆕 New session started! How can I help you with bioinformatics tools today?</p>
                          </div>
                      </div>
                  </div>
              `;
              
              await loadSessions();
              hideSidebar();
              saveState();
          }
      } catch (error) {
          console.error('Error starting new session:', error);
      }
  }

  async function loadSession(sessionId) {
      if (!isMemoryEnabled) return;
      
      try {
          const response = await fetch(`/api/agent/sessions/${sessionId}/load`, {
              method: 'POST'
          });
          const data = await response.json();
          
          if (data.success) {
              currentSessionId = sessionId;
              sessionStatus.textContent = `Session: ${sessionId.slice(-8)}`;
              
              // Load conversation history
              const historyResponse = await fetch('/api/agent/history');
              const historyData = await historyResponse.json();
              
              chatBody.innerHTML = '';
              if (historyData.history && historyData.history.length > 0) {
                  historyData.history.forEach(turn => {
                      addMessage(turn.content, turn.role);
                  });
              } else {
                  chatBody.innerHTML = `
                      <div class="chat chat-start">
                          <div class="chat-bubble chat-bubble-primary">
                              <div class="markdown-content">
                                  <p>📂 Session loaded! Continue our conversation.</p>
                              </div>
                          </div>
                      </div>
                  `;
              }
              
              await loadSessions();
              hideSidebar();
              saveState();
          }
      } catch (error) {
          console.error('Error loading session:', error);
      }
  }

  async function deleteSession(sessionId) {
      if (!isMemoryEnabled) return;
      
      if (confirm(`Delete session ${sessionId.slice(-8)}? This cannot be undone.`)) {
          try {
              const response = await fetch(`/api/agent/sessions/${sessionId}`, {
                  method: 'DELETE'
              });
              const data = await response.json();
              
              if (data.success) {
                  if (sessionId === currentSessionId) {
                      currentSessionId = null;
                      sessionStatus.textContent = 'No active session';
                      
                      // Clear chat and show session deleted message
                      chatBody.innerHTML = `
                          <div class="chat chat-start">
                              <div class="chat-bubble chat-bubble-warning">
                                  <div class="markdown-content">
                                      <p>🗑️ Session deleted. Start a new conversation!</p>
                                  </div>
                              </div>
                          </div>
                      `;
                      saveState();
                  }
                  await loadSessions();
              }
          } catch (error) {
              console.error('Error deleting session:', error);
          }
      }
  }

  async function saveCurrentSession() {
      if (!isMemoryEnabled) return;
      
      try {
          const response = await fetch('/api/agent/sessions/save', {
              method: 'POST'
          });
          const data = await response.json();
          
          if (data.success) {
              // Show brief success indicator
              const originalText = saveSessionBtn.innerHTML;
              saveSessionBtn.innerHTML = '<i class="ti ti-check"></i>';
              saveSessionBtn.classList.add('btn-success');
              
              setTimeout(() => {
                  saveSessionBtn.innerHTML = originalText;
                  saveSessionBtn.classList.remove('btn-success');
              }, 1500);
          }
      } catch (error) {
          console.error('Error saving session:', error);
      }
  }

  async function cleanupOldSessions() {
      if (!isMemoryEnabled) return;
      
      const days = prompt('Keep sessions from how many days ago? (default: 30)', '30');
      if (days === null) return;
      
      try {
          const response = await fetch('/api/agent/sessions/cleanup', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ daysToKeep: parseInt(days) || 30 })
          });
          const data = await response.json();
          
          if (data.success) {
              alert(`Cleaned up ${data.deleted_count} old sessions`);
              await loadSessions();
          }
      } catch (error) {
          console.error('Error cleaning up sessions:', error);
      }
  }

  // Enhanced clear history function
  function clearChatHistory() {
      if (isMemoryEnabled) {
          if (confirm('Clear current session history? This will clear the conversation but keep the session.')) {
              fetch('/api/agent/clear-history', { method: 'POST' })
                  .then(() => {
                      chatBody.innerHTML = `
                          <div class="chat chat-start">
                              <div class="chat-bubble chat-bubble-primary">
                                  <div class="markdown-content">
                                      <p>🧹 Session cleared! Ready for a fresh conversation.</p>
                                  </div>
                              </div>
                          </div>
                      `;
                      saveState();
                  })
                  .catch(error => console.error('Error clearing history:', error));
          }
      } else {
          // Basic mode - just clear locally
          chatBody.innerHTML = `
              <div class="chat chat-start">
                  <div class="chat-bubble chat-bubble-primary">
                      <div class="markdown-content"><p>Hello! How can I help you with bioinformatics tools today?</p></div>
                  </div>
              </div>
          `;
          saveState();
      }
  }

  // Check markdown library availability (simple like test-marked.html)
  function checkMarkdownSupport() {
    if (typeof marked !== 'undefined' && marked.parse) {
      console.log('✅ Marked.js library loaded successfully');
      if (typeof hljs !== 'undefined') {
        console.log('✅ Highlight.js loaded - syntax highlighting enabled');
      }
      return true;
    } else {
      console.error('❌ Marked.js library not available');
      return false;
    }
  }



  // Debug function to compare original vs rendered text
  window.debugMarkdown = function(originalText, renderedHtml) {
    console.group('🔍 Markdown Debug');
    console.log('📝 Original text:', originalText);
    console.log('🎨 Rendered HTML:', renderedHtml);
    console.log('📏 Original length:', originalText.length);
    console.log('📏 Rendered length:', renderedHtml.length);
    
    // Check for common markdown patterns
    const hasHeaders = /^#+\s/.test(originalText);
    const hasBold = /\*\*.*?\*\*/.test(originalText);
    const hasCode = /`.*?`/.test(originalText);
    const hasCodeBlocks = /```/.test(originalText);
    
    console.log('🔍 Contains headers:', hasHeaders);
    console.log('🔍 Contains bold:', hasBold);
    console.log('🔍 Contains inline code:', hasCode);
    console.log('🔍 Contains code blocks:', hasCodeBlocks);
    console.groupEnd();
  };

  

  // Initial status check and state load (simple like test-marked.html)
  document.addEventListener('DOMContentLoaded', () => {
    // Simple initialization like test-marked.html
    setTimeout(() => {
      initializeMarked();
      checkMarkdownSupport();
    loadState();
    checkAgentStatusLoop();
    }, 100);
  });
</script>

<!-- Load highlight.js first, then marked.js (using different CDN) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<script>
// Initialize marked.js (exactly like test-marked.html)
function initializeMarked() {
    if (typeof marked === 'undefined') {
        console.error('Marked.js not available');
        return false;
    }
    
    // Configure marked.js with highlight.js (back to simple version)
    marked.setOptions({
        highlight: function(code, lang) {
            if (typeof hljs !== 'undefined' && lang && hljs.getLanguage(lang)) {
                try {
                    return hljs.highlight(code, { language: lang, ignoreIllegals: true }).value;
                } catch (error) {
                    console.warn('Highlight.js error for language', lang, ':', error);
                }
            }
            return code;
        },
        breaks: true,
        gfm: true,
        tables: true,
        sanitize: false,
        smartLists: true,
        smartypants: true
    });
    
    console.log('✅ Marked.js configured successfully');
    return true;
}

  // Add copy buttons to code blocks after markdown rendering
  function addCopyButtonsToCodeBlocks(container) {
    const codeBlocks = container.querySelectorAll('pre code');
    codeBlocks.forEach(codeElement => {
      const preElement = codeElement.parentElement;
      if (preElement && !preElement.querySelector('.copy-code-btn')) {
        // Generate unique ID for this code block
        const codeId = 'code-' + Math.random().toString(36).substr(2, 9);
        codeElement.id = codeId;
        
        // Get language from class name
        let lang = 'text';
        const langMatch = codeElement.className.match(/language-(\S+)/);
        if (langMatch) {
          lang = langMatch[1];
        }
        
        // Create code block container
        const container = document.createElement('div');
        container.className = 'code-block-container relative';
        
        // Create header with copy button
        const header = document.createElement('div');
        header.className = 'code-header flex justify-between items-center text-xs text-gray-400 px-3 py-2 bg-gray-800 rounded-t-lg';
        header.innerHTML = `
          <span>${lang}</span>
          <button class="copy-code-btn btn btn-xs btn-ghost" data-code-id="${codeId}" title="Copy code">
            <i class="ti ti-copy"></i>
          </button>
        `;
        
        // Wrap the pre element
        preElement.parentElement.insertBefore(container, preElement);
        container.appendChild(header);
        container.appendChild(preElement);
        
        // Update pre element styles
        preElement.style.margin = '0';
        preElement.style.borderRadius = '0 0 0.5rem 0.5rem';
      }
    });
  }

  // Copy functionality
  function copyToClipboard(text) {
    if (navigator.clipboard && window.isSecureContext) {
      return navigator.clipboard.writeText(text);
    } else {
      // Fallback for older browsers
      const textArea = document.createElement('textarea');
      textArea.value = text;
      textArea.style.position = 'absolute';
      textArea.style.left = '-999999px';
      document.body.prepend(textArea);
      textArea.select();
      try {
        document.execCommand('copy');
      } catch (error) {
        console.error('Copy failed:', error);
      } finally {
        textArea.remove();
      }
    }
  }

  // Event delegation for copy buttons
  document.addEventListener('click', (e) => {
    // Copy code button
    if (e.target.closest('.copy-code-btn')) {
      const btn = e.target.closest('.copy-code-btn');
      const codeId = btn.getAttribute('data-code-id');
      const codeElement = document.getElementById(codeId);
      if (codeElement) {
        const code = codeElement.textContent || codeElement.innerText;
        copyToClipboard(code).then(() => {
          // Visual feedback
          const originalIcon = btn.innerHTML;
          btn.innerHTML = '<i class="ti ti-check"></i>';
          btn.classList.add('btn-success');
          setTimeout(() => {
            btn.innerHTML = originalIcon;
            btn.classList.remove('btn-success');
          }, 2000);
        }).catch(err => {
          console.error('Failed to copy code:', err);
        });
      }
    }
    
    // Copy full answer button
    if (e.target.closest('.copy-answer-btn')) {
      const btn = e.target.closest('.copy-answer-btn');
      const chatBubble = btn.closest('.chat-bubble');
      if (chatBubble) {
        const markdownContent = chatBubble.querySelector('.markdown-content');
        const text = markdownContent ? markdownContent.textContent || markdownContent.innerText : chatBubble.textContent || chatBubble.innerText;
        copyToClipboard(text).then(() => {
          // Visual feedback
          const originalIcon = btn.innerHTML;
          btn.innerHTML = '<i class="ti ti-check"></i>';
          btn.classList.add('btn-success');
          setTimeout(() => {
            btn.innerHTML = originalIcon;
            btn.classList.remove('btn-success');
          }, 2000);
        }).catch(err => {
          console.error('Failed to copy answer:', err);
        });
      }
    }
    
    // Edit and resend button
    if (e.target.closest('.edit-resend-btn')) {
      const btn = e.target.closest('.edit-resend-btn');
      const userBubble = btn.closest('.chat-bubble');
      if (userBubble) {
        const originalText = userBubble.textContent || userBubble.innerText;
        chatInput.value = originalText.trim();
        chatInput.focus();
        chatInput.select();
      }
    }
  });

  // Simple test function (like test-marked.html)
  window.testMarkdown = function(text) {
    try {
      const result = marked.parse(text);
      console.log('Test result:', result);
      return result;
    } catch (error) {
      console.error('Test failed:', error);
      return `<p>Error: ${error.message}</p>`;
    }
  };
</script>

