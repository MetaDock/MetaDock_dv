        let message = '🔍 Conda Installation Check Results:\n\n';
        
        if (data.condaAvailable) {
          message += '✅ Conda is installed and available\n';
          message += `📍 Installation Path: ${data.condaPath}\n\n`;
          message += 'You can now try to get the environment list.';
        } else {
          message += '❌ Conda not found\n\n';
          message += 'Possible reasons:\n';
          message += '• conda is not installed\n';
          message += '• conda is not in system PATH\n';
          message += '• need to activate conda environment first\n\n';
          message += 'Suggestions:\n';
          message += '1. Install Miniconda or Anaconda\n';
          message += '2. Ensure conda is in PATH\n';
          message += '3. Restart terminal session';
        }
        
        alert(message);
      } else {
        throw new Error(data.error || 'Unknown error');
      }
    } catch (error) {
      console.error('❌ Error testing conda availability:', error);
      alert('❌ Failed to check conda installation status:\n\n' + error.message + '\n\nPlease check server connection.');
    }
  }

  // Test conda environments function
  async function testCondaEnvironments() {
    console.log('🐍 Testing conda environments...');
    
    try {
      const response = await fetch('/api/conda-environments');
      const data = await response.json();
      
      if (data.success) {
        console.log('✅ Conda environments loaded successfully:', data.environments);
        
        let envList = '🐍 Available Conda Environments:\n\n';
        if (data.environments.length === 0) {
          envList += '❌ No conda environments found\n';
        } else {
          data.environments.forEach((env, index) => {
            envList += `${index + 1}. ${env.name}`;
            if (env.active) envList += ' (Currently Active)';
            envList += '\n   Path: ' + env.path + '\n\n';
          });
        }
        
        envList += `\nTotal ${data.environments.length} environments found`;
        if (data.commandUsed) {
          envList += '\n\nSuccessfully executed command: ' + data.commandUsed;
        }
        envList += '\n\nRaw Output:\n' + data.rawOutput;
        
        alert(envList);
      } else {
        throw new Error(data.error || 'Unknown error');
      }
    } catch (error) {
      console.error('❌ Error testing conda environments:', error);
      alert('❌ Failed to get conda environments:\n\n' + error.message + '\n\nPlease ensure:\n1. Server connection is normal\n2. Conda is installed on server\n3. Conda command is in PATH');
    }
  }

  // Detect conda paths function
  async function detectCondaPaths() {
    console.log('🔍 Detecting conda paths...');
    
    try {
      const response = await fetch('/api/conda-terminal');
      const data = await response.json();
      
      if (data.success) {
        let pathInfo = '🔍 Conda Path Detection Results:\n\n';
        pathInfo += data.output;
        
        // Parse key information
        const lines = data.output.split('\n');
        let condaPath = '';
        let envs = [];
        
        lines.forEach(line => {
          if (line.includes('/conda') && !line.includes('not found')) {
            condaPath = line.trim();
          }
          if (line.includes('spades_env') || line.includes('quast_env')) {
            envs.push(line.trim());
          }
        });
        
        pathInfo += '\n\n📋 Key Information:\n';
        pathInfo += `Conda Installation Path: ${condaPath || 'Not Found'}\n`;
        pathInfo += `Environment List: ${envs.length > 0 ? envs.join(', ') : 'spades_env/quast_env not found'}\n`;
        
        alert(pathInfo);
      } else {
        throw new Error(data.error || 'Unknown error');
      }
    } catch (error) {
      console.error('❌ Error detecting conda paths:', error);
      alert('❌ Failed to detect conda paths:\n\n' + error.message);
    }
  }

  // Test mock workflow function
  async function testMockWorkflow() {
    console.log('🧪 Testing mock SPAdes + QUAST workflow...');
    
    try {
      const response = await fetch('/api/run-mock-spades-quast', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          workingDir: '/home/hoshigawarei',
          spadesEnv: 'spades_env',  // Use environment name instead of full path
          quastEnv: 'quast_env'     // Use environment name instead of full path
        })
      });
      
      if (!response.ok) {
        throw new Error(`HTTP ${response.status}: ${response.statusText}`);
      }
      
      const data = await response.json();
      
      let message = '🧬 Mock Workflow Test Results:\n\n';
      
      if (data.success) {
        message += '✅ Workflow completed successfully!\n\n';
      } else {
        message += '❌ Workflow failed:\n' + data.error + '\n\n';
      }
      
      if (data.results && data.results.steps) {
        message += `📊 Execution Summary:\n`;
        message += `• Total steps: ${data.results.totalSteps || data.results.steps.length}\n`;
        message += `• Successful steps: ${data.results.successfulSteps || 0}\n`;
        message += `• Duration: ${data.results.startTime} to ${data.results.endTime || 'running'}\n\n`;
        
        message += `📝 Step Details:\n`;
        data.results.steps.forEach((step, index) => {
          message += `${index + 1}. ${step.tool}:\n`;
          message += `   Command: ${step.command}\n`;
          message += `   Exit Code: ${step.exitCode}\n`;
          message += `   Time: ${step.timestamp}\n\n`;
        });
      }
      
      alert(message);
      
    } catch (error) {
      console.error('❌ Error testing mock workflow:', error);
      
      let errorMessage = '❌ Mock workflow test failed:\n\n';
      
      if (error.message.includes('Unexpected token')) {
        errorMessage += '🔌 Connection Error: Please establish server connection first.\n\n';
        errorMessage += 'Go to the login page and connect to your server.';
      } else if (error.message.includes('401')) {
        errorMessage += '🔐 Authentication Error: No connection established.\n\n';
        errorMessage += 'Please login and establish server connection first.';
      } else {
        errorMessage += error.message;
      }
      
      alert(errorMessage);
    }
  }

  // Global functions needed by the modal
  function closeComponentConfig() {
    document.getElementById('component-config-modal').close();
  }

  function saveComponentConfig() {
    if (window.workflowBuilder && window.workflowBuilder.saveComponentConfig) {
      window.workflowBuilder.saveComponentConfig();
    }
  }
  
  // Global error handlers to prevent uncaught promise errors
  window.addEventListener('unhandledrejection', function(event) {
    console.warn('Unhandled promise rejection:', event.reason);
    // Prevent the default behavior (logging to console)
    event.preventDefault();
  });

  window.addEventListener('error', function(event) {
    console.warn('Global error:', event.error);
  });

  document.addEventListener('DOMContentLoaded', initializeWorkflowBuilder);
</script> 