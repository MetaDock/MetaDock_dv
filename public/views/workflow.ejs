    // Center canvas after a short delay to ensure layout is ready
    setTimeout(() => {
      centerCanvas();
    }, 100);
    
    // Update counts when nodes are added/removed
    const observer = new MutationObserver(function(mutations) {
      let shouldUpdate = false;
      mutations.forEach(mutation => {
        if (mutation.type === 'childList') {
          const addedNodes = Array.from(mutation.addedNodes);
          const removedNodes = Array.from(mutation.removedNodes);
          
          if (addedNodes.some(node => node.classList && node.classList.contains('workflow-node')) ||
              removedNodes.some(node => node.classList && node.classList.contains('workflow-node'))) {
            shouldUpdate = true;
          }
        }
      });
      
      if (shouldUpdate) {
        updateNodeCount();
        updateConnectionCount();
      }
    });
    
    const canvas = document.getElementById('workflow-canvas');
    if (canvas) {
      observer.observe(canvas, { childList: true, subtree: true });
    }
  });

