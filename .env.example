# Node / Server
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-random-64-plus-char-secret

# Remote execution (workflow/SSH, replace with your paths)
REMOTE_WORKDIR=/path/to/remote/workdir
WORKING_DIR=/path/to/working/dir
CONDA_PATH=/path/to/miniconda3

# Agent (Python backend)
AGENT_HEALTH_URL=http://127.0.0.1:5111/health

# Workflow Builder Configuration
WORKFLOW_TEMP_DIR=/tmp/workflow_temp
WORKFLOW_MAX_EXECUTION_TIME=3600
WORKFLOW_MAX_CONCURRENT_JOBS=5
WORKFLOW_LOG_LEVEL=info

# File Upload Configuration for Workflow
WORKFLOW_UPLOAD_MAX_SIZE=100MB
WORKFLOW_ALLOWED_FILE_TYPES=.fastq,.fq,.fasta,.fa,.sam,.bam,.txt,.csv,.json

# Workflow Execution Configuration
WORKFLOW_DEFAULT_TIMEOUT=300
WORKFLOW_RETRY_ATTEMPTS=3
WORKFLOW_RETRY_DELAY=5000

# Workflow Storage Configuration
WORKFLOW_SAVE_DIR=./workflows
WORKFLOW_BACKUP_ENABLED=true
WORKFLOW_BACKUP_RETENTION_DAYS=30

# API Keys (set real values locally in .env)
DASHSCOPE_API_KEY=your_dashscope_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

OLLAMA_HOST=http://localhost:11434

VIZ_REMOTE_TMP=/path/to/remote/tmp/metadock_viz
VIZ_MAX_RUNTIME=60
VIZ_PYTHON=/path/to/python3
